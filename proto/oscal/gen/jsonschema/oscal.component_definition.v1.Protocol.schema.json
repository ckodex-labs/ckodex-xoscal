{
  "$id": "oscal.component_definition.v1.Protocol.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Protocol represents a protocol used by the component",
  "patternProperties": {
    "^(portNumbers)$": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "properties": {
    "description": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
      },
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.json"
      },
      "type": "array"
    },
    "name": {
      "default": "",
      "type": "string"
    },
    "port_numbers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
      },
      "type": "array"
    },
    "title": {
      "items": {
        "$ref": "oscal.common.v1.MarkupLine.schema.json"
      },
      "type": "array"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.schema.json"
    }
  },
  "title": "Protocol",
  "type": "object"
}
