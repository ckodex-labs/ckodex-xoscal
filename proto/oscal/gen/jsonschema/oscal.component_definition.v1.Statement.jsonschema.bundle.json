{
  "$defs": {
    "oscal.common.v1.Link.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(media_type)$": {
          "default": "",
          "type": "string"
        },
        "^(resource_fragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.jsonschema.json"
        },
        "mediaType": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resourceFragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.URI.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.component_definition.v1.Statement.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Statement represents a control implementation statement",
      "patternProperties": {
        "^(by_components)$": {
          "items": {
            "$ref": "#/$defs/oscal.component_definition.v1.Statement.jsonschema.json"
          },
          "type": "array"
        },
        "^(statement_id)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "byComponents": {
          "items": {
            "$ref": "#/$defs/oscal.component_definition.v1.Statement.jsonschema.json"
          },
          "type": "array"
        },
        "description": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.json"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.json"
          },
          "type": "array"
        },
        "statementId": {
          "default": "",
          "type": "string"
        },
        "uuid": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Statement",
      "type": "object"
    }
  },
  "$id": "oscal.component_definition.v1.Statement.jsonschema.bundle.json",
  "$ref": "#/$defs/oscal.component_definition.v1.Statement.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
