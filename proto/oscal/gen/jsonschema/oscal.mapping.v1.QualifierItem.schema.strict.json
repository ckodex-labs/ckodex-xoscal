{
  "$id": "oscal.mapping.v1.QualifierItem.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "QualifierItem represents an OSCAL relationship qualifier. Fields 1-4 are\n retained for wire compatibility with the pre-release mapping prototype.",
  "properties": {
    "category": {
      "type": "string"
    },
    "description": {
      "$ref": "oscal.common.v1.MarkupMultiline.schema.strict.json"
    },
    "id_ref": {
      "type": "string"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.strict.json"
      },
      "type": "array"
    },
    "predicate": {
      "type": "string"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.strict.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.strict.json"
      },
      "type": "array"
    },
    "subject": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "id_ref",
    "subject",
    "predicate",
    "category"
  ],
  "title": "Qualifier Item",
  "type": "object"
}
