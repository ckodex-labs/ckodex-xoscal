{
  "$id": "oscal.services.v1.SearchResult.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "modelType": {
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ],
          "type": "string"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.jsonschema.strict.json"
    }
  },
  "required": [
    "modelType",
    "title",
    "score"
  ],
  "title": "Search Result",
  "type": "object"
}
