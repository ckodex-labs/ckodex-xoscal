{
  "$defs": {
    "oscal.catalog.v1.Constraint.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Constraint represents a constraint on a parameter value",
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Constraint",
      "type": "object"
    },
    "oscal.catalog.v1.Parameter.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameter represents a control parameter",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Constraint.schema.json"
          },
          "type": "array"
        },
        "guidance": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        },
        "id": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
        },
        "label": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "select": {
          "$ref": "#/$defs/oscal.catalog.v1.Select.schema.json"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Parameter",
      "type": "object"
    },
    "oscal.catalog.v1.Select.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Select represents a selection of parameter values",
      "patternProperties": {
        "^(howMany)$": {
          "default": false,
          "type": "boolean"
        }
      },
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
          },
          "type": "array"
        },
        "how_many": {
          "default": false,
          "type": "boolean"
        }
      },
      "title": "Select",
      "type": "object"
    },
    "oscal.common.v1.Link.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(mediaType)$": {
          "default": "",
          "type": "string"
        },
        "^(resourceFragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.json"
        },
        "media_type": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resource_fragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.Token.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Token represents an alphanumeric token (e.g., control IDs)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Token",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    }
  },
  "$id": "oscal.catalog.v1.Parameter.schema.bundle.json",
  "$ref": "#/$defs/oscal.catalog.v1.Parameter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
