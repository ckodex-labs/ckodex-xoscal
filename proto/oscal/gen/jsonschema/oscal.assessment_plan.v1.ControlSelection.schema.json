{
  "$id": "oscal.assessment_plan.v1.ControlSelection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "ControlSelection represents a control selection",
  "patternProperties": {
    "^(excludeControls)$": {
      "items": {
        "$ref": "oscal.assessment_plan.v1.SelectedControl.schema.json"
      },
      "type": "array"
    },
    "^(includeControls)$": {
      "items": {
        "$ref": "oscal.assessment_plan.v1.SelectedControl.schema.json"
      },
      "type": "array"
    }
  },
  "properties": {
    "description": {
      "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
    },
    "exclude_controls": {
      "items": {
        "$ref": "oscal.assessment_plan.v1.SelectedControl.schema.json"
      },
      "type": "array"
    },
    "include_controls": {
      "items": {
        "$ref": "oscal.assessment_plan.v1.SelectedControl.schema.json"
      },
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
      },
      "type": "array"
    }
  },
  "title": "Control Selection",
  "type": "object"
}
