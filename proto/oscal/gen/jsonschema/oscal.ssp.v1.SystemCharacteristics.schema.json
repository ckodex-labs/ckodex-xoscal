    },
    "^(responsibleParties)$": {
      "items": {
        "$ref": "oscal.common.v1.ResponsibleParty.schema.json"
      },
      "type": "array"
    },
    "^(securityImpactLevel)$": {
      "$ref": "oscal.ssp.v1.SecurityImpactLevel.schema.json"
