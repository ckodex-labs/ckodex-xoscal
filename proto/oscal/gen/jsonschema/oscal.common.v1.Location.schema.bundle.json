{
  "$defs": {
    "oscal.common.v1.AddrLine.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "AddrLine represents a line of an address",
      "properties": {
        "value": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        }
      },
      "title": "Addr Line",
      "type": "object"
    },
    "oscal.common.v1.Address.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Address represents a postal address",
      "patternProperties": {
        "^(addrLines)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.AddrLine.schema.json"
          },
          "type": "array"
        },
        "^(postalCode)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "addr_lines": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.AddrLine.schema.json"
          },
          "type": "array"
        },
        "city": {
          "default": "",
          "type": "string"
        },
        "country": {
          "default": "",
          "type": "string"
        },
        "postal_code": {
          "default": "",
          "type": "string"
        },
        "state": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Address",
      "type": "object"
    },
    "oscal.common.v1.EmailAddress.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "EmailAddress represents an email address",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Email Address",
      "type": "object"
    },
    "oscal.common.v1.Link.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(mediaType)$": {
          "default": "",
          "type": "string"
        },
        "^(resourceFragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.json"
        },
        "media_type": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resource_fragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.Location.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Location represents a physical or virtual location",
      "patternProperties": {
        "^(emailAddresses)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.EmailAddress.schema.json"
          },
          "type": "array"
        },
        "^(telephoneNumbers)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.TelephoneNumber.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "address": {
          "$ref": "#/$defs/oscal.common.v1.Address.schema.json"
        },
        "email_addresses": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.EmailAddress.schema.json"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "telephone_numbers": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.TelephoneNumber.schema.json"
          },
          "type": "array"
        },
        "title": {
          "default": "",
          "type": "string"
        },
        "urls": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.URI.schema.json"
          },
          "type": "array"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "ns": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.TelephoneNumber.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "TelephoneNumber represents a telephone number",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Telephone Number",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "UUID",
      "type": "object"
    }
  },
  "$id": "oscal.common.v1.Location.schema.bundle.json",
  "$ref": "#/$defs/oscal.common.v1.Location.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
