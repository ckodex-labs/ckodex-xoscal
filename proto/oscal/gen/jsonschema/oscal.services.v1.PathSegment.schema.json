{
  "$id": "oscal.services.v1.PathSegment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "depth": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        {
          "pattern": "^-?[0-9]+$",
          "type": "string"
        }
      ],
      "default": 0
    },
    "edge": {
      "$ref": "oscal.services.v1.GraphEdge.schema.json"
    },
    "node": {
      "$ref": "oscal.services.v1.GraphNode.schema.json"
    }
  },
  "title": "Path Segment",
  "type": "object"
}
