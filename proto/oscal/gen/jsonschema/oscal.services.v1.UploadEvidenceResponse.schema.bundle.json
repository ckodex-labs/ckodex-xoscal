{
  "$defs": {
    "google.protobuf.Timestamp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "oscal.services.v1.Evidence.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(bomKind)$": {
          "default": "",
          "type": "string"
        },
        "^(createdAt)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "^(extensionsJson)$": {
          "default": "",
          "type": "string"
        },
        "^(integrityMethodsJson)$": {
          "default": "",
          "type": "string"
        },
        "^(mediaType)$": {
          "default": "",
          "type": "string"
        },
        "^(predicateType)$": {
          "default": "",
          "type": "string"
        },
        "^(producedByJson)$": {
          "default": "",
          "type": "string"
        },
        "^(sizeBytes)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(specJson)$": {
          "default": "",
          "type": "string"
        },
        "^(subjectRefs)$": {
          "items": {
            "$ref": "#/$defs/oscal.services.v1.Reference.schema.json"
          },
          "type": "array"
        },
        "^(validTime)$": {
          "$ref": "#/$defs/oscal.services.v1.TimeWindow.schema.json"
        }
      },
      "properties": {
        "bom_kind": {
          "default": "",
          "type": "string"
        },
        "classification": {
          "default": "",
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "digest": {
          "default": "",
          "type": "string"
        },
        "extensions_json": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "integrity_methods_json": {
          "default": "",
          "type": "string"
        },
        "media_type": {
          "default": "",
          "type": "string"
        },
        "predicate_type": {
          "default": "",
          "type": "string"
        },
        "produced_by_json": {
          "default": "",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "spec_json": {
          "default": "",
          "type": "string"
        },
        "storage": {
          "$ref": "#/$defs/oscal.services.v1.Storage.schema.json"
        },
        "subject_refs": {
          "items": {
            "$ref": "#/$defs/oscal.services.v1.Reference.schema.json"
          },
          "type": "array"
        },
        "supersedes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "valid_time": {
          "$ref": "#/$defs/oscal.services.v1.TimeWindow.schema.json"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "oscal.services.v1.Reference.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(bomRef)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "bom_ref": {
          "default": "",
          "type": "string"
        },
        "digest": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "default": "",
          "type": "string"
        },
        "purl": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Reference",
      "type": "object"
    },
    "oscal.services.v1.Storage.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(airGapJson)$": {
          "default": "",
          "type": "string"
        },
        "^(fetchPolicy)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "air_gap_json": {
          "default": "",
          "type": "string"
        },
        "fetch_policy": {
          "default": "",
          "type": "string"
        },
        "quorum": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "uris": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Storage",
      "type": "object"
    },
    "oscal.services.v1.TimeWindow.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(fromTime)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "^(toTime)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        }
      },
      "properties": {
        "from_time": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "to_time": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        }
      },
      "title": "Time Window",
      "type": "object"
    },
    "oscal.services.v1.UploadEvidenceResponse.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/oscal.services.v1.Evidence.schema.json"
        },
        "stored": {
          "default": false,
          "type": "boolean"
        }
      },
      "title": "Upload Evidence Response",
      "type": "object"
    }
  },
  "$id": "oscal.services.v1.UploadEvidenceResponse.schema.bundle.json",
  "$ref": "#/$defs/oscal.services.v1.UploadEvidenceResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
