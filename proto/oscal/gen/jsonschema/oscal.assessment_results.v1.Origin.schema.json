{
  "$id": "oscal.assessment_results.v1.Origin.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Origin represents the origin of a finding",
  "patternProperties": {
    "^(relatedTasks)$": {
      "items": {
        "$ref": "oscal.assessment_results.v1.RelatedTask.schema.json"
      },
      "type": "array"
    }
  },
  "properties": {
    "actors": {
      "items": {
        "$ref": "oscal.assessment_results.v1.OriginActor.schema.json"
      },
      "type": "array"
    },
    "related_tasks": {
      "items": {
        "$ref": "oscal.assessment_results.v1.RelatedTask.schema.json"
      },
      "type": "array"
    }
  },
  "title": "Origin",
  "type": "object"
}
