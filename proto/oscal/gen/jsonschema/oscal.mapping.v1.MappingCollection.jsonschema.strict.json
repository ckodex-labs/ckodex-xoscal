{
  "$id": "oscal.mapping.v1.MappingCollection.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "MappingCollection is the OSCAL 1.2 mapping-collection document root.\n Fields 3-15 predate the released Mapping model and are retained only for\n wire compatibility; new code uses provenance, mappings, and back_matter.",
  "properties": {
    "backMatter": {
      "$ref": "oscal.common.v1.BackMatter.jsonschema.strict.json"
    },
    "confidenceScore": {
      "$ref": "oscal.mapping.v1.ConfidenceScore.jsonschema.strict.json"
    },
    "coverage": {
      "$ref": "oscal.mapping.v1.Coverage.jsonschema.strict.json"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.jsonschema.strict.json"
      },
      "type": "array"
    },
    "mappingDescription": {
      "$ref": "oscal.mapping.v1.MappingDescription.jsonschema.strict.json"
    },
    "mappings": {
      "items": {
        "$ref": "oscal.mapping.v1.ControlMapping.jsonschema.strict.json"
      },
      "type": "array"
    },
    "maps": {
      "items": {
        "$ref": "oscal.mapping.v1.Map.jsonschema.strict.json"
      },
      "type": "array"
    },
    "matchingRationale": {
      "type": "string"
    },
    "metadata": {
      "$ref": "oscal.common.v1.Metadata.jsonschema.strict.json"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.jsonschema.strict.json"
      },
      "type": "array"
    },
    "provenance": {
      "$ref": "oscal.mapping.v1.MappingProvenance.jsonschema.strict.json"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
      },
      "type": "array"
    },
    "sourceGapSummary": {
      "$ref": "oscal.mapping.v1.GapSummary.jsonschema.strict.json"
    },
    "sourceResource": {
      "$ref": "oscal.mapping.v1.MappingResourceReference.jsonschema.strict.json"
    },
    "status": {
      "type": "string"
    },
    "targetGapSummary": {
      "$ref": "oscal.mapping.v1.GapSummary.jsonschema.strict.json"
    },
    "targetResource": {
      "$ref": "oscal.mapping.v1.MappingResourceReference.jsonschema.strict.json"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.jsonschema.strict.json"
    }
  },
  "required": [
    "matchingRationale",
    "status"
  ],
  "title": "Mapping Collection",
  "type": "object"
}
