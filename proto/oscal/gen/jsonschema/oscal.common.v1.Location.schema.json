{
  "$id": "oscal.common.v1.Location.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Location represents a physical or virtual location",
  "patternProperties": {
    "^(emailAddresses)$": {
      "items": {
        "$ref": "oscal.common.v1.EmailAddress.schema.json"
      },
      "type": "array"
    },
    "^(telephoneNumbers)$": {
      "items": {
        "$ref": "oscal.common.v1.TelephoneNumber.schema.json"
      },
      "type": "array"
    }
  },
  "properties": {
    "address": {
      "$ref": "oscal.common.v1.Address.schema.json"
    },
    "email_addresses": {
      "items": {
        "$ref": "oscal.common.v1.EmailAddress.schema.json"
      },
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
      },
      "type": "array"
    },
    "telephone_numbers": {
      "items": {
        "$ref": "oscal.common.v1.TelephoneNumber.schema.json"
      },
      "type": "array"
    },
    "title": {
      "default": "",
      "type": "string"
    },
    "urls": {
      "items": {
        "$ref": "oscal.common.v1.URI.schema.json"
      },
      "type": "array"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.schema.json"
    }
  },
  "title": "Location",
  "type": "object"
}
