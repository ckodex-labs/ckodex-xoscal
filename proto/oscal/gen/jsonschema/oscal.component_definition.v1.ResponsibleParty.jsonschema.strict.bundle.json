{
  "$defs": {
    "oscal.common.v1.Link.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.jsonschema.strict.json"
        },
        "mediaType": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "resourceFragment": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "rel",
        "mediaType",
        "text",
        "resourceFragment"
      ],
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ns": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "class",
        "id",
        "ns"
      ],
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.URI.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "UUID",
      "type": "object"
    },
    "oscal.component_definition.v1.ResponsibleParty.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ResponsibleParty represents a party responsible for the component",
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.strict.json"
          },
          "type": "array"
        },
        "partyUuids": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
          },
          "type": "array"
        },
        "roleId": {
          "type": "string"
        }
      },
      "required": [
        "roleId"
      ],
      "title": "Responsible Party",
      "type": "object"
    }
  },
  "$id": "oscal.component_definition.v1.ResponsibleParty.jsonschema.strict.bundle.json",
  "$ref": "#/$defs/oscal.component_definition.v1.ResponsibleParty.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
