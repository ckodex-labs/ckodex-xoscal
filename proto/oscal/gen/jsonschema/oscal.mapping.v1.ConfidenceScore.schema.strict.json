{
  "$id": "oscal.mapping.v1.ConfidenceScore.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "ConfidenceScore is either a category or a percentage from 0 through 1.\n Fields 1-5 are retained for wire compatibility with the prototype model.",
  "properties": {
    "category": {
      "type": "string"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.strict.json"
      },
      "type": "array"
    },
    "method": {
      "type": "string"
    },
    "percentage": {
      "$ref": "oscal.common.v1.Decimal.schema.strict.json"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.strict.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.strict.json"
      },
      "type": "array"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ],
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "value",
    "method",
    "category"
  ],
  "title": "Confidence Score",
  "type": "object"
}
