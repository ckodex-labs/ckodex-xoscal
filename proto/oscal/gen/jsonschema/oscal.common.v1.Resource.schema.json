{
  "$id": "oscal.common.v1.Resource.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Resource represents an external resource",
  "patternProperties": {
    "^(citationObj)$": {
      "$ref": "oscal.common.v1.Citation.schema.json"
    },
    "^(documentIds)$": {
      "items": {
        "$ref": "oscal.common.v1.DocumentId.schema.json"
      },
      "type": "array"
    }
  },
  "properties": {
    "base64": {
      "items": {
        "$ref": "oscal.common.v1.Base64.schema.json"
      },
      "type": "array"
    },
    "citation": {
      "default": "",
      "description": "Deprecated: use citation_obj instead. Kept for backward compatibility.",
      "type": "string"
    },
    "citation_obj": {
      "$ref": "oscal.common.v1.Citation.schema.json"
    },
    "description": {
      "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
    },
    "document_ids": {
      "items": {
        "$ref": "oscal.common.v1.DocumentId.schema.json"
      },
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "rlinks": {
      "items": {
        "$ref": "oscal.common.v1.Rlink.schema.json"
      },
      "type": "array"
    },
    "title": {
      "default": "",
      "type": "string"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.schema.json"
    }
  },
  "title": "Resource",
  "type": "object"
}
