{
  "$defs": {
    "oscal.common.v1.AddrLine.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "AddrLine represents a line of an address",
      "properties": {
        "value": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.strict.json"
        }
      },
      "title": "Addr Line",
      "type": "object"
    },
    "oscal.common.v1.Address.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Address represents a postal address",
      "properties": {
        "addrLines": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.AddrLine.jsonschema.strict.json"
          },
          "type": "array"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "city",
        "state",
        "postalCode",
        "country"
      ],
      "title": "Address",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Line",
      "type": "object"
    }
  },
  "$id": "oscal.common.v1.Address.jsonschema.strict.bundle.json",
  "$ref": "#/$defs/oscal.common.v1.Address.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
