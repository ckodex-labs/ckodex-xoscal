{
  "$id": "oscal.catalog.v1.Parameter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Parameter represents a control parameter",
  "properties": {
    "class": {
      "default": "",
      "type": "string"
    },
    "constraints": {
      "items": {
        "$ref": "oscal.catalog.v1.Constraint.schema.json"
      },
      "type": "array"
    },
    "guidance": {
      "$ref": "oscal.common.v1.MarkupLine.schema.json",
      "description": "Deprecated: use guidelines instead. Kept for backward compatibility."
    },
    "guidelines": {
      "items": {
        "$ref": "oscal.catalog.v1.Guideline.schema.json"
      },
      "type": "array"
    },
    "id": {
      "$ref": "oscal.common.v1.Token.schema.json"
    },
    "label": {
      "$ref": "oscal.common.v1.MarkupLine.schema.json"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
      },
      "type": "array"
    },
    "select": {
      "$ref": "oscal.catalog.v1.Select.schema.json"
    },
    "values": {
      "items": {
        "$ref": "oscal.common.v1.MarkupLine.schema.json"
      },
      "type": "array"
    }
  },
  "title": "Parameter",
  "type": "object"
}
