{
  "$defs": {
    "oscal.services.v1.ImportBatchResponse.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "committed": {
          "default": false,
          "type": "boolean"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/oscal.services.v1.ImportRecordResult.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Import Batch Response",
      "type": "object"
    },
    "oscal.services.v1.ImportRecordResult.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(claimId)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "claim_id": {
          "default": "",
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "index": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "status": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Import Record Result",
      "type": "object"
    }
  },
  "$id": "oscal.services.v1.ImportBatchResponse.schema.bundle.json",
  "$ref": "#/$defs/oscal.services.v1.ImportBatchResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
