{
  "$defs": {
    "oscal.catalog.v1.Select.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Select represents a selection of parameter values",
      "patternProperties": {
        "^(howMany)$": {
          "default": false,
          "type": "boolean"
        }
      },
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
          },
          "type": "array"
        },
        "how_many": {
          "default": false,
          "type": "boolean"
        }
      },
      "title": "Select",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    }
  },
  "$id": "oscal.catalog.v1.Select.schema.bundle.json",
  "$ref": "#/$defs/oscal.catalog.v1.Select.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
