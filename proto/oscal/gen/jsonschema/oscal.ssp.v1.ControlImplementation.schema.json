{
  "$id": "oscal.ssp.v1.ControlImplementation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "ControlImplementation represents control implementation",
  "patternProperties": {
    "^(implementedRequirements)$": {
      "items": {
        "$ref": "oscal.ssp.v1.ImplementedRequirement.schema.json"
      },
      "type": "array"
    },
    "^(setParameters)$": {
      "items": {
        "$ref": "oscal.ssp.v1.SetParameter.schema.json"
      },
      "type": "array"
    }
  },
  "properties": {
