{
  "$id": "oscal.ssp.v1.Statement.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Statement represents a control statement",
  "properties": {
    "by_components": {
      "items": {
        "$ref": "oscal.ssp.v1.ByComponent.schema.strict.json"
      },
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.strict.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.strict.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.strict.json"
      },
      "type": "array"
    },
    "responsible_roles": {
      "items": {
        "$ref": "oscal.ssp.v1.ResponsibleRole.schema.strict.json"
      },
      "type": "array"
    },
    "statement_id": {
      "$ref": "oscal.common.v1.Token.schema.strict.json"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.schema.strict.json"
    }
  },
  "title": "Statement",
  "type": "object"
}
