{
  "$defs": {
    "oscal.common.v1.Link.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.jsonschema.strict.json"
        },
        "mediaType": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "resourceFragment": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "rel",
        "mediaType",
        "text",
        "resourceFragment"
      ],
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "class",
        "id"
      ],
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.URI.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "UUID",
      "type": "object"
    },
    "oscal.poam.v1.Origin.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Origin represents the origin of a POAM item",
      "properties": {
        "actors": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.OriginActor.jsonschema.strict.json"
          },
          "type": "array"
        }
      },
      "title": "Origin",
      "type": "object"
    },
    "oscal.poam.v1.OriginActor.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "OriginActor represents an originating actor",
      "properties": {
        "actorUuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.strict.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.strict.json"
        }
      },
      "title": "Origin Actor",
      "type": "object"
    },
    "oscal.poam.v1.PoamItem.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "PoamItem represents a POAM item as defined by the OSCAL 1.1.2 schema.\n Unlike Risk, poam-item is a simpler container with title, description,\n and references to findings/observations/risks.",
      "properties": {
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.strict.json"
          },
          "type": "array"
        },
        "origins": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.Origin.jsonschema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.strict.json"
          },
          "type": "array"
        },
        "relatedFindings": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedFinding.jsonschema.strict.json"
          },
          "type": "array"
        },
        "relatedObservations": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedObservation.jsonschema.strict.json"
          },
          "type": "array"
        },
        "relatedRisks": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedRisk.jsonschema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.strict.json"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.strict.json"
        }
      },
      "title": "Poam Item",
      "type": "object"
    },
    "oscal.poam.v1.RelatedFinding.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelatedFinding represents a related finding",
      "properties": {
        "findingUuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.strict.json"
        }
      },
      "title": "Related Finding",
      "type": "object"
    },
    "oscal.poam.v1.RelatedObservation.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelatedObservation represents a related observation",
      "properties": {
        "observationUuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.strict.json"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
          },
          "type": "array"
        }
      },
      "title": "Related Observation",
      "type": "object"
    },
    "oscal.poam.v1.RelatedRisk.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelatedRisk represents a related risk",
      "properties": {
        "riskUuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.strict.json"
        }
      },
      "title": "Related Risk",
      "type": "object"
    }
  },
  "$id": "oscal.poam.v1.PoamItem.jsonschema.strict.bundle.json",
  "$ref": "#/$defs/oscal.poam.v1.PoamItem.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
