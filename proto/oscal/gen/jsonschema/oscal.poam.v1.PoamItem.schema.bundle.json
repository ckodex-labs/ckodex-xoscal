{
  "$defs": {
    "oscal.common.v1.Link.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(mediaType)$": {
          "default": "",
          "type": "string"
        },
        "^(resourceFragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.json"
        },
        "media_type": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resource_fragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "ns": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "UUID",
      "type": "object"
    },
    "oscal.poam.v1.Origin.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Origin represents the origin of a POAM item",
      "properties": {
        "actors": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.OriginActor.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Origin",
      "type": "object"
    },
    "oscal.poam.v1.OriginActor.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "OriginActor represents an originating actor",
      "patternProperties": {
        "^(actorUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "actor_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        }
      },
      "title": "Origin Actor",
      "type": "object"
    },
    "oscal.poam.v1.PoamItem.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "PoamItem represents a POAM item as defined by the OSCAL 1.1.2 schema.\n Unlike Risk, poam-item is a simpler container with title, description,\n and references to findings/observations/risks.",
      "patternProperties": {
        "^(relatedFindings)$": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedFinding.schema.json"
          },
          "type": "array"
        },
        "^(relatedObservations)$": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedObservation.schema.json"
          },
          "type": "array"
        },
        "^(relatedRisks)$": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedRisk.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "origins": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.Origin.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "related_findings": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedFinding.schema.json"
          },
          "type": "array"
        },
        "related_observations": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedObservation.schema.json"
          },
          "type": "array"
        },
        "related_risks": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedRisk.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Poam Item",
      "type": "object"
    },
    "oscal.poam.v1.RelatedFinding.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelatedFinding represents a related finding",
      "patternProperties": {
        "^(findingUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "finding_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Related Finding",
      "type": "object"
    },
    "oscal.poam.v1.RelatedObservation.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelatedObservation represents a related observation",
      "patternProperties": {
        "^(observationUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "observation_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Related Observation",
      "type": "object"
    },
    "oscal.poam.v1.RelatedRisk.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelatedRisk represents a related risk",
      "patternProperties": {
        "^(riskUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "risk_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Related Risk",
      "type": "object"
    }
  },
  "$id": "oscal.poam.v1.PoamItem.schema.bundle.json",
  "$ref": "#/$defs/oscal.poam.v1.PoamItem.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
