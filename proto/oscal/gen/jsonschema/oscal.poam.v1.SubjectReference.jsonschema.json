{
  "$id": "oscal.poam.v1.SubjectReference.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "SubjectReference represents a subject reference",
  "patternProperties": {
    "^(subject_uuid)$": {
      "$ref": "oscal.common.v1.UUID.jsonschema.json"
    }
  },
  "properties": {
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.jsonschema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.jsonschema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.jsonschema.json"
      },
      "type": "array"
    },
    "subjectUuid": {
      "$ref": "oscal.common.v1.UUID.jsonschema.json"
    },
    "title": {
      "$ref": "oscal.common.v1.MarkupLine.jsonschema.json"
    }
  },
  "title": "Subject Reference",
  "type": "object"
}
