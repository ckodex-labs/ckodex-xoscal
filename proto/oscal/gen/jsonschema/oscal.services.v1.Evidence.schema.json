{
  "$id": "oscal.services.v1.Evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "patternProperties": {
    "^(bomKind)$": {
      "default": "",
      "type": "string"
    },
    "^(createdAt)$": {
      "$ref": "google.protobuf.Timestamp.schema.json"
    },
    "^(extensionsJson)$": {
      "default": "",
      "type": "string"
    },
    "^(integrityMethodsJson)$": {
      "default": "",
      "type": "string"
    },
    "^(mediaType)$": {
      "default": "",
      "type": "string"
    },
    "^(predicateType)$": {
      "default": "",
      "type": "string"
    },
    "^(producedByJson)$": {
      "default": "",
      "type": "string"
    },
    "^(sizeBytes)$": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "pattern": "^-?[0-9]+$",
          "type": "string"
        }
      ],
      "default": 0
    },
    "^(specJson)$": {
      "default": "",
      "type": "string"
    },
    "^(subjectRefs)$": {
      "items": {
        "$ref": "oscal.services.v1.Reference.schema.json"
      },
      "type": "array"
    },
    "^(validTime)$": {
      "$ref": "oscal.services.v1.TimeWindow.schema.json"
    }
  },
  "properties": {
    "bom_kind": {
      "default": "",
      "type": "string"
    },
    "classification": {
      "default": "",
      "type": "string"
    },
    "created_at": {
      "$ref": "google.protobuf.Timestamp.schema.json"
    },
    "digest": {
      "default": "",
      "type": "string"
    },
    "extensions_json": {
      "default": "",
      "type": "string"
    },
    "id": {
      "default": "",
      "type": "string"
    },
    "integrity_methods_json": {
      "default": "",
      "type": "string"
    },
    "media_type": {
      "default": "",
      "type": "string"
    },
    "predicate_type": {
      "default": "",
      "type": "string"
    },
    "produced_by_json": {
      "default": "",
      "type": "string"
    },
    "size_bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "pattern": "^-?[0-9]+$",
          "type": "string"
        }
      ],
      "default": 0
    },
    "spec_json": {
      "default": "",
      "type": "string"
    },
    "storage": {
      "$ref": "oscal.services.v1.Storage.schema.json"
    },
    "subject_refs": {
      "items": {
        "$ref": "oscal.services.v1.Reference.schema.json"
      },
      "type": "array"
    },
    "supersedes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "valid_time": {
      "$ref": "oscal.services.v1.TimeWindow.schema.json"
    }
  },
  "title": "Evidence",
  "type": "object"
}
