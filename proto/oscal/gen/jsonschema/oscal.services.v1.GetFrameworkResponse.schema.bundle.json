      "title": "Framework Summary",
      "type": "object"
    },
    "oscal.services.v1.GetFrameworkResponse.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "framework": {
          "$ref": "#/$defs/oscal.services.v1.FrameworkSummary.schema.json"
        }
      },
      "title": "Get Framework Response",
      "type": "object"
    }
  },
  "$id": "oscal.services.v1.GetFrameworkResponse.schema.bundle.json",
