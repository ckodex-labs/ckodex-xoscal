{
  "$id": "oscal.common.v1.Decimal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Decimal represents a decimal value",
  "properties": {
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "default": 0
    }
  },
  "title": "Decimal",
  "type": "object"
}
