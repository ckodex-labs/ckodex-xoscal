{
  "$id": "oscal.component_definition.v1.Capability.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Capability represents a grouping of control implementations",
  "properties": {
    "control_implementations": {
      "items": {
        "$ref": "oscal.component_definition.v1.ControlImplementation.schema.strict.json"
      },
      "type": "array"
    },
    "description": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.strict.json"
      },
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.strict.json"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.strict.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.strict.json"
      },
      "type": "array"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.schema.strict.json"
    }
  },
  "required": [
    "name"
  ],
  "title": "Capability",
  "type": "object"
}
