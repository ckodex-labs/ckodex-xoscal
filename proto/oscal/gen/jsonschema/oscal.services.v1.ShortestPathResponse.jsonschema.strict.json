{
  "$id": "oscal.services.v1.ShortestPathResponse.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "$ref": "oscal.services.v1.GraphEdge.jsonschema.strict.json"
      },
      "type": "array"
    },
    "found": {
      "type": "boolean"
    },
    "totalWeight": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ],
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "totalWeight",
    "found"
  ],
  "title": "Shortest Path Response",
  "type": "object"
}
