{
  "$defs": {
    "oscal.common.v1.Link.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.jsonschema.strict.json"
        },
        "mediaType": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "resourceFragment": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "rel",
        "mediaType",
        "text",
        "resourceFragment"
      ],
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ns": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "class",
        "id",
        "ns"
      ],
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.Token.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Token represents an alphanumeric token (e.g., control IDs)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Token",
      "type": "object"
    },
    "oscal.common.v1.URI.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "UUID",
      "type": "object"
    },
    "oscal.mapping.v1.GapSummary.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "GapSummary selects controls that are not mapped.\n Fields 1-5 are retained for wire compatibility with the prototype model.",
      "properties": {
        "count": {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
          },
          "type": "array"
        },
        "unmappedControls": {
          "items": {
            "$ref": "#/$defs/oscal.mapping.v1.SelectControlById.jsonschema.strict.json"
          },
          "type": "array"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.strict.json"
        }
      },
      "required": [
        "count"
      ],
      "title": "Gap Summary",
      "type": "object"
    },
    "oscal.mapping.v1.Matching.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Matching selects controls by a glob expression.",
      "properties": {
        "pattern": {
          "type": "string"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
          },
          "type": "array"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "Matching",
      "type": "object"
    },
    "oscal.mapping.v1.SelectControlById.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SelectControlById selects explicit or pattern-matched controls.",
      "properties": {
        "matching": {
          "items": {
            "$ref": "#/$defs/oscal.mapping.v1.Matching.jsonschema.strict.json"
          },
          "type": "array"
        },
        "withChildControls": {
          "type": "string"
        },
        "withIds": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Token.jsonschema.strict.json"
          },
          "type": "array"
        }
      },
      "required": [
        "withChildControls"
      ],
      "title": "Select Control By Id",
      "type": "object"
    }
  },
  "$id": "oscal.mapping.v1.GapSummary.jsonschema.strict.bundle.json",
  "$ref": "#/$defs/oscal.mapping.v1.GapSummary.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
