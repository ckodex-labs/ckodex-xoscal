{
  "$defs": {
    "oscal.common.v1.Decimal.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Decimal represents a decimal value",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ],
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "title": "Decimal",
      "type": "object"
    },
    "oscal.common.v1.Link.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(media_type)$": {
          "default": "",
          "type": "string"
        },
        "^(resource_fragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.jsonschema.json"
        },
        "mediaType": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resourceFragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "ns": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.URI.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.mapping.v1.Coverage.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Coverage records target coverage and the method used to derive it.\n Fields 1-5 are retained for wire compatibility with the prototype model.",
      "patternProperties": {
        "^(generation_method)$": {
          "default": "",
          "type": "string"
        },
        "^(target_coverage)$": {
          "$ref": "#/$defs/oscal.common.v1.Decimal.jsonschema.json"
        }
      },
      "properties": {
        "generationMethod": {
          "default": "",
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.json"
          },
          "type": "array"
        },
        "method": {
          "default": "",
          "type": "string"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.json"
          },
          "type": "array"
        },
        "targetCoverage": {
          "$ref": "#/$defs/oscal.common.v1.Decimal.jsonschema.json"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ],
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "title": "Coverage",
      "type": "object"
    }
  },
  "$id": "oscal.mapping.v1.Coverage.jsonschema.bundle.json",
  "$ref": "#/$defs/oscal.mapping.v1.Coverage.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
