{
  "$id": "oscal.mapping.v1.ConfidenceScore.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "ConfidenceScore is either a category or a percentage from 0 through 1.\n Fields 1-5 are retained for wire compatibility with the prototype model.",
  "properties": {
    "category": {
      "default": "",
      "type": "string"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.jsonschema.json"
      },
      "type": "array"
    },
    "method": {
      "default": "",
      "type": "string"
    },
    "percentage": {
      "$ref": "oscal.common.v1.Decimal.jsonschema.json"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.jsonschema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.jsonschema.json"
      },
      "type": "array"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "default": 0
    }
  },
  "title": "Confidence Score",
  "type": "object"
}
