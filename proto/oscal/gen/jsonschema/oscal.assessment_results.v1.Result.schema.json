{
  "$id": "oscal.assessment_results.v1.Result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Result represents an assessment result",
  "patternProperties": {
    "^(reviewedControls)$": {
      "$ref": "oscal.assessment_results.v1.ReviewedControls.schema.json",
      "description": "reviewed_controls is required by the OSCAL 1.1.2 schema for each result."
    }
  },
  "properties": {
    "description": {
      "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
    },
    "end": {
      "$ref": "oscal.common.v1.DateTime.schema.json"
    },
    "findings": {
      "items": {
        "$ref": "oscal.assessment_results.v1.Finding.schema.json"
      },
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.json"
      },
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "oscal.assessment_results.v1.Observation.schema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
      },
      "type": "array"
    },
    "reviewed_controls": {
      "$ref": "oscal.assessment_results.v1.ReviewedControls.schema.json",
      "description": "reviewed_controls is required by the OSCAL 1.1.2 schema for each result."
    },
    "start": {
      "$ref": "oscal.common.v1.DateTime.schema.json"
    },
    "title": {
      "$ref": "oscal.common.v1.MarkupLine.schema.json"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.schema.json"
    }
  },
  "title": "Result",
  "type": "object"
}
