{
  "$id": "oscal.component_definition.v1.DefinedComponent.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "DefinedComponent represents a component description",
  "properties": {
    "control_implementations": {
      "items": {
        "$ref": "oscal.component_definition.v1.ControlImplementation.schema.strict.json"
      },
      "type": "array"
    },
    "description": {
      "$ref": "oscal.common.v1.MarkupMultiline.schema.strict.json"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.strict.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.strict.json"
      },
      "type": "array"
    },
    "protocols": {
      "items": {
        "$ref": "oscal.component_definition.v1.Protocol.schema.strict.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.strict.json"
      },
      "type": "array"
    },
    "responsible_parties": {
      "items": {
        "$ref": "oscal.component_definition.v1.ResponsibleParty.schema.strict.json"
      },
      "type": "array"
    },
    "supply_chain_type": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "$ref": "oscal.common.v1.MarkupLine.schema.strict.json"
    },
    "type": {
      "type": "string"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.schema.strict.json"
    }
  },
  "required": [
    "type"
  ],
  "title": "Defined Component",
  "type": "object"
}
