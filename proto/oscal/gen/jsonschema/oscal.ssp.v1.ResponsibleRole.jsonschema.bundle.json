{
  "$defs": {
    "oscal.common.v1.MarkupMultiline.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.Token.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Token represents an alphanumeric token (e.g., control IDs)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Token",
      "type": "object"
    },
    "oscal.common.v1.UUID.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "UUID",
      "type": "object"
    },
    "oscal.ssp.v1.ResponsibleRole.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ResponsibleRole represents a responsible role",
      "patternProperties": {
        "^(party_uuids)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
          },
          "type": "array"
        },
        "^(role_id)$": {
          "$ref": "#/$defs/oscal.common.v1.Token.jsonschema.json"
        }
      },
      "properties": {
        "partyUuids": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.json"
          },
          "type": "array"
        },
        "roleId": {
          "$ref": "#/$defs/oscal.common.v1.Token.jsonschema.json"
        }
      },
      "title": "Responsible Role",
      "type": "object"
    }
  },
  "$id": "oscal.ssp.v1.ResponsibleRole.jsonschema.bundle.json",
  "$ref": "#/$defs/oscal.ssp.v1.ResponsibleRole.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
