  "$id": "oscal.ssp.v1.SystemImplementation.schema.strict.bundle.json",
  "$ref": "#/$defs/oscal.ssp.v1.SystemImplementation.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
