        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.strict.json"
        }
      },
      "title": "Leveraged Authorization",
      "type": "object"
    },
    "oscal.ssp.v1.Status.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Status represents system status",
      "properties": {
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "Status",
      "type": "object"
    },
    "oscal.ssp.v1.SystemComponent.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SystemComponent represents a system component",
      "properties": {
        "description": {
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
