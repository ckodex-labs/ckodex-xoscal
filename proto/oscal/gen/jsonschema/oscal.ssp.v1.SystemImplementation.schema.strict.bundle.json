      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SystemUser represents a system user",
      "properties": {
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "short_name": {
          "type": "string"
