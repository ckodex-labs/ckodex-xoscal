        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "users": {
          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.SystemUser.schema.strict.json"
          },
          "type": "array"
        }
      },
      "title": "System Implementation",
      "type": "object"
    },
