{
  "$defs": {
    "google.protobuf.Timestamp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "oscal.assessment_results.v1.Observation.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Observation represents an observation",
      "patternProperties": {
        "^(relevantEvidence)$": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.RelevantEvidence.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "collected": {
          "$ref": "#/$defs/oscal.common.v1.DateTime.schema.json"
        },
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
        },
        "expires": {
          "$ref": "#/$defs/oscal.common.v1.DateTime.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "methods": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "origins": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.Origin.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "relevant_evidence": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.RelevantEvidence.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.SubjectReference.schema.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        },
        "types": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Observation",
      "type": "object"
    },
    "oscal.assessment_results.v1.Origin.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Origin represents the origin of a finding",
      "patternProperties": {
        "^(relatedTasks)$": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.RelatedTask.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "actors": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.OriginActor.schema.json"
          },
          "type": "array"
        },
        "related_tasks": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.RelatedTask.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Origin",
      "type": "object"
    },
    "oscal.assessment_results.v1.OriginActor.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "OriginActor represents an originating actor",
      "patternProperties": {
        "^(actorUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "actor_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        }
      },
      "title": "Origin Actor",
      "type": "object"
    },
    "oscal.assessment_results.v1.RelatedTask.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelatedTask represents a related task",
      "patternProperties": {
        "^(taskUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "task_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        }
      },
      "title": "Related Task",
      "type": "object"
    },
    "oscal.assessment_results.v1.RelevantEvidence.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelevantEvidence represents relevant evidence",
      "properties": {
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
        },
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URIReference.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Relevant Evidence",
      "type": "object"
    },
    "oscal.assessment_results.v1.SubjectReference.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SubjectReference represents a subject reference",
      "patternProperties": {
        "^(subjectUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "subject_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        },
        "type": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Subject Reference",
      "type": "object"
    },
    "oscal.common.v1.DateTime.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "DateTime represents a date-time with timezone (RFC3339)",
      "properties": {
        "value": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        }
      },
      "title": "Date Time",
      "type": "object"
    },
    "oscal.common.v1.Link.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(mediaType)$": {
          "default": "",
          "type": "string"
        },
        "^(resourceFragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.json"
        },
        "media_type": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resource_fragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.URIReference.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URIReference represents a URI reference (may be relative)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI Reference",
      "type": "object"
    },
    "oscal.common.v1.UUID.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "UUID",
      "type": "object"
    }
  },
  "$id": "oscal.assessment_results.v1.Observation.schema.bundle.json",
  "$ref": "#/$defs/oscal.assessment_results.v1.Observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
