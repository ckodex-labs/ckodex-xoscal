{
  "$defs": {
    "google.protobuf.Timestamp.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "oscal.common.v1.DateTime.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "DateTime represents a date-time with timezone (RFC3339)",
      "properties": {
        "value": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        }
      },
      "title": "Date Time",
      "type": "object"
    },
    "oscal.common.v1.Link.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(media_type)$": {
          "default": "",
          "type": "string"
        },
        "^(resource_fragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.jsonschema.json"
        },
        "mediaType": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resourceFragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.Token.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Token represents an alphanumeric token (e.g., control IDs)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Token",
      "type": "object"
    },
    "oscal.common.v1.URI.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "UUID",
      "type": "object"
    },
    "oscal.poam.v1.RelatedTask.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelatedTask represents a related task",
      "patternProperties": {
        "^(task_uuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
        }
      },
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.json"
          },
          "type": "array"
        },
        "taskUuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.json"
        }
      },
      "title": "Related Task",
      "type": "object"
    },
    "oscal.poam.v1.Response.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Response represents a risk response/remediation",
      "patternProperties": {
        "^(related_tasks)$": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedTask.jsonschema.json"
          },
          "type": "array"
        },
        "^(responsible_roles)$": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.ResponsibleRole.jsonschema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "deadline": {
          "$ref": "#/$defs/oscal.common.v1.DateTime.jsonschema.json"
        },
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.json"
          },
          "type": "array"
        },
        "relatedTasks": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedTask.jsonschema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.json"
          },
          "type": "array"
        },
        "responsibleRoles": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.ResponsibleRole.jsonschema.json"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/oscal.poam.v1.ResponseStatus.jsonschema.json"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.SubjectReference.jsonschema.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.json"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
        }
      },
      "title": "Response",
      "type": "object"
    },
    "oscal.poam.v1.ResponseStatus.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ResponseStatus represents response status",
      "properties": {
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.json"
          },
          "type": "array"
        },
        "state": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Response Status",
      "type": "object"
    },
    "oscal.poam.v1.ResponsibleRole.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ResponsibleRole represents a responsible role",
      "patternProperties": {
        "^(party_uuids)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
          },
          "type": "array"
        },
        "^(role_id)$": {
          "$ref": "#/$defs/oscal.common.v1.Token.jsonschema.json"
        }
      },
      "properties": {
        "partyUuids": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.json"
          },
          "type": "array"
        },
        "roleId": {
          "$ref": "#/$defs/oscal.common.v1.Token.jsonschema.json"
        }
      },
      "title": "Responsible Role",
      "type": "object"
    },
    "oscal.poam.v1.SubjectReference.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SubjectReference represents a subject reference",
      "patternProperties": {
        "^(subject_uuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
        }
      },
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.json"
          },
          "type": "array"
        },
        "subjectUuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.json"
        }
      },
      "title": "Subject Reference",
      "type": "object"
    }
  },
  "$id": "oscal.poam.v1.Response.jsonschema.bundle.json",
  "$ref": "#/$defs/oscal.poam.v1.Response.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
