{
  "$defs": {
    "oscal.assessment_results.v1.AssociatedRisk.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "AssociatedRisk represents an associated risk",
      "patternProperties": {
        "^(riskUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "risk_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Associated Risk",
      "type": "object"
    },
    "oscal.assessment_results.v1.Finding.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Finding represents a finding",
      "patternProperties": {
        "^(implementationStatementUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "^(relatedObservations)$": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.RelatedObservation.schema.json"
          },
          "type": "array"
        },
        "^(relatedRisks)$": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.AssociatedRisk.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
        },
        "implementation_statement_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "origins": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.Origin.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "related_observations": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.RelatedObservation.schema.json"
          },
          "type": "array"
        },
        "related_risks": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.AssociatedRisk.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/oscal.assessment_results.v1.FindingTarget.schema.json"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Finding",
      "type": "object"
    },
    "oscal.assessment_results.v1.FindingTarget.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "FindingTarget represents a finding target",
      "patternProperties": {
        "^(implementationStatus)$": {
          "$ref": "#/$defs/oscal.assessment_results.v1.ImplementationStatus.schema.json"
        },
        "^(targetId)$": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
        }
      },
      "properties": {
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
        },
        "implementation_status": {
          "$ref": "#/$defs/oscal.assessment_results.v1.ImplementationStatus.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/oscal.assessment_results.v1.ObjectiveStatus.schema.json"
        },
        "target_id": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        },
        "type": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Finding Target",
      "type": "object"
    },
    "oscal.assessment_results.v1.ImplementationStatus.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ImplementationStatus represents implementation status",
      "properties": {
        "remarks": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
        },
        "state": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Implementation Status",
      "type": "object"
    },
    "oscal.assessment_results.v1.ObjectiveStatus.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ObjectiveStatus represents objective status",
      "properties": {
        "reason": {
          "default": "",
          "type": "string"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "state": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Objective Status",
      "type": "object"
    },
    "oscal.assessment_results.v1.Origin.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Origin represents the origin of a finding",
      "patternProperties": {
        "^(relatedTasks)$": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.RelatedTask.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "actors": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.OriginActor.schema.json"
          },
          "type": "array"
        },
        "related_tasks": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.RelatedTask.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Origin",
      "type": "object"
    },
    "oscal.assessment_results.v1.OriginActor.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "OriginActor represents an originating actor",
      "patternProperties": {
        "^(actorUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "actor_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        }
      },
      "title": "Origin Actor",
      "type": "object"
    },
    "oscal.assessment_results.v1.RelatedObservation.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelatedObservation represents a related observation",
      "patternProperties": {
        "^(observationUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "observation_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Related Observation",
      "type": "object"
    },
    "oscal.assessment_results.v1.RelatedTask.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelatedTask represents a related task",
      "patternProperties": {
        "^(taskUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "task_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        }
      },
      "title": "Related Task",
      "type": "object"
    },
    "oscal.common.v1.Link.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(mediaType)$": {
          "default": "",
          "type": "string"
        },
        "^(resourceFragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.json"
        },
        "media_type": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resource_fragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "ns": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.Token.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Token represents an alphanumeric token (e.g., control IDs)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Token",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "UUID",
      "type": "object"
    }
  },
  "$id": "oscal.assessment_results.v1.Finding.schema.bundle.json",
  "$ref": "#/$defs/oscal.assessment_results.v1.Finding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
