      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.strict.json"
        },
        "media_type": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "resource_fragment": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "rel",
        "media_type",
        "text",
        "resource_fragment"
      ],
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
