{
  "$id": "oscal.ssp.v1.SetParameter.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "SetParameter represents a set parameter",
  "properties": {
    "param_id": {
      "$ref": "oscal.common.v1.Token.schema.strict.json"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.strict.json"
      },
      "type": "array"
    },
    "value": {
      "description": "Deprecated: use values instead. Kept for backward compatibility.",
      "type": "string"
    },
    "values": {
      "description": "values is the OSCAL schema-required array of parameter values.",
      "items": {
        "$ref": "oscal.common.v1.MarkupLine.schema.strict.json"
      },
      "type": "array"
    }
  },
  "required": [
    "value"
  ],
  "title": "Set Parameter",
  "type": "object"
}
