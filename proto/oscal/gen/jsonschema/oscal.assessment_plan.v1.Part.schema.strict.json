{
  "$id": "oscal.assessment_plan.v1.Part.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Part represents a part of an objective",
  "properties": {
    "class": {
      "type": "string"
    },
    "id": {
      "$ref": "oscal.common.v1.Token.schema.strict.json"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.strict.json"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "ns": {
      "type": "string"
    },
    "parts": {
      "items": {
        "$ref": "#"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.strict.json"
      },
      "type": "array"
    },
    "prose": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.strict.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.strict.json"
      },
      "type": "array"
    },
    "title": {
      "$ref": "oscal.common.v1.MarkupLine.schema.strict.json"
    }
  },
  "required": [
    "name",
    "ns",
    "class"
  ],
  "title": "Part",
  "type": "object"
}
