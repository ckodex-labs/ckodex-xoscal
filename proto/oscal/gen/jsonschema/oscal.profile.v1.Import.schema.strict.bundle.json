{
  "$defs": {
    "oscal.catalog.v1.Constraint.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Constraint represents a constraint on a parameter value",
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "required": [
        "description"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "oscal.catalog.v1.Control.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Control represents a security control",
      "properties": {
        "class": {
          "type": "string"
        },
        "controls": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Control.schema.strict.json"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.strict.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "params": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Parameter.schema.strict.json"
          },
          "type": "array"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Part.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.strict.json"
        }
      },
      "required": [
        "class"
      ],
      "title": "Control",
      "type": "object"
    },
    "oscal.catalog.v1.Parameter.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameter represents a control parameter",
      "properties": {
        "class": {
          "type": "string"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Constraint.schema.strict.json"
          },
          "type": "array"
        },
        "guidance": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.strict.json"
        },
        "id": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.strict.json"
        },
        "label": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.strict.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "select": {
          "$ref": "#/$defs/oscal.catalog.v1.Select.schema.strict.json"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.strict.json"
          },
          "type": "array"
        }
      },
      "required": [
        "class"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "oscal.catalog.v1.Part.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Part represents a part of a control (e.g., statement, objective)",
      "properties": {
        "class": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.strict.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "ns": {
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Part.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "prose": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.strict.json"
        }
      },
      "required": [
        "name",
        "ns",
        "class"
      ],
      "title": "Part",
      "type": "object"
    },
    "oscal.catalog.v1.Select.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Select represents a selection of parameter values",
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.strict.json"
          },
          "type": "array"
        },
        "how_many": {
          "type": "boolean"
        }
      },
      "required": [
        "how_many"
      ],
      "title": "Select",
      "type": "object"
    },
    "oscal.common.v1.Link.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.strict.json"
        },
        "media_type": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "resource_fragment": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "rel",
        "media_type",
        "text",
        "resource_fragment"
      ],
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "class",
        "id"
      ],
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.Token.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Token represents an alphanumeric token (e.g., control IDs)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Token",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.URIReference.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URIReference represents a URI reference (may be relative)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "URI Reference",
      "type": "object"
    },
    "oscal.profile.v1.Custom.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Custom represents custom control additions",
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "with_class": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "with_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Custom",
      "type": "object"
    },
    "oscal.profile.v1.ExcludeControls.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ExcludeControls represents controls to exclude from the imported resource",
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "with_class": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "with_ids": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Control.schema.strict.json"
          },
          "type": "array"
        }
      },
      "title": "Exclude Controls",
      "type": "object"
    },
    "oscal.profile.v1.Import.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Import represents a reference to a source catalog or profile",
      "properties": {
        "custom": {
          "$ref": "#/$defs/oscal.profile.v1.Custom.schema.strict.json"
        },
        "exclude_controls": {
          "items": {
            "$ref": "#/$defs/oscal.profile.v1.ExcludeControls.schema.strict.json"
          },
          "type": "array"
        },
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URIReference.schema.strict.json"
        },
        "include_all": {
          "$ref": "#/$defs/oscal.profile.v1.IncludeAll.schema.strict.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        }
      },
      "title": "Import",
      "type": "object"
    },
    "oscal.profile.v1.IncludeAll.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "IncludeAll represents including all controls from the imported resource",
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "params": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Parameter.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        }
      },
      "title": "Include All",
      "type": "object"
    }
  },
  "$id": "oscal.profile.v1.Import.schema.strict.bundle.json",
  "$ref": "#/$defs/oscal.profile.v1.Import.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
