          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.ByComponent.schema.json"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "responsible_roles": {
          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.ResponsibleRole.schema.json"
          },
          "type": "array"
        },
        "statement_id": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Statement",
      "type": "object"
