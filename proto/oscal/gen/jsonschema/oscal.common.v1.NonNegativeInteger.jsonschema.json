{
  "$id": "oscal.common.v1.NonNegativeInteger.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "NonNegativeInteger represents a non-negative integer",
  "properties": {
    "value": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "pattern": "^-?[0-9]+$",
          "type": "string"
        }
      ],
      "default": 0
    }
  },
  "title": "Non Negative Integer",
  "type": "object"
}
