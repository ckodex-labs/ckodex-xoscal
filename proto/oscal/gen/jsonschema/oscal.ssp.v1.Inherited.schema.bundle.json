{
  "$defs": {
    "oscal.common.v1.Link.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(mediaType)$": {
          "default": "",
          "type": "string"
        },
        "^(resourceFragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.json"
        },
        "media_type": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resource_fragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "ns": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.Token.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Token represents an alphanumeric token (e.g., control IDs)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Token",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "UUID",
      "type": "object"
    },
    "oscal.ssp.v1.Inherited.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Inherited represents inherited control implementation",
      "patternProperties": {
        "^(providedUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "^(responsibleRoles)$": {
          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.ResponsibleRole.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "provided_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "responsible_roles": {
          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.ResponsibleRole.schema.json"
          },
          "type": "array"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Inherited",
      "type": "object"
    },
    "oscal.ssp.v1.ResponsibleRole.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ResponsibleRole represents a responsible role",
      "patternProperties": {
        "^(partyUuids)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
          },
          "type": "array"
        },
        "^(roleId)$": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
        }
      },
      "properties": {
        "party_uuids": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "role_id": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
        }
      },
      "title": "Responsible Role",
      "type": "object"
    }
  },
  "$id": "oscal.ssp.v1.Inherited.schema.bundle.json",
  "$ref": "#/$defs/oscal.ssp.v1.Inherited.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
