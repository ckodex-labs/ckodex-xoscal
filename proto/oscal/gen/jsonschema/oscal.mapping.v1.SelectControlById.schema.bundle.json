{
  "$defs": {
    "oscal.common.v1.MarkupMultiline.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Token.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Token represents an alphanumeric token (e.g., control IDs)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Token",
      "type": "object"
    },
    "oscal.mapping.v1.Matching.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Matching selects controls by a glob expression.",
      "properties": {
        "pattern": {
          "default": "",
          "type": "string"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Matching",
      "type": "object"
    },
    "oscal.mapping.v1.SelectControlById.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SelectControlById selects explicit or pattern-matched controls.",
      "patternProperties": {
        "^(withChildControls)$": {
          "default": "",
          "type": "string"
        },
        "^(withIds)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "matching": {
          "items": {
            "$ref": "#/$defs/oscal.mapping.v1.Matching.schema.json"
          },
          "type": "array"
        },
        "with_child_controls": {
          "default": "",
          "type": "string"
        },
        "with_ids": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Select Control By Id",
      "type": "object"
    }
  },
  "$id": "oscal.mapping.v1.SelectControlById.schema.bundle.json",
  "$ref": "#/$defs/oscal.mapping.v1.SelectControlById.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
