{
  "$defs": {
    "oscal.common.v1.Link.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(media_type)$": {
          "default": "",
          "type": "string"
        },
        "^(resource_fragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.jsonschema.json"
        },
        "mediaType": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resourceFragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "ns": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.URI.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.profile.v1.Combine.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Combine represents combine method for merging",
      "patternProperties": {
        "^(as_is)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "asIs": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.json"
          },
          "type": "array"
        },
        "flat": {
          "default": false,
          "type": "boolean"
        },
        "method": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Combine",
      "type": "object"
    },
    "oscal.profile.v1.Custom.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Custom represents custom control additions",
      "patternProperties": {
        "^(with_class)$": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "^(with_ids)$": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.json"
          },
          "type": "array"
        },
        "withClass": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "withIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Custom",
      "type": "object"
    },
    "oscal.profile.v1.Merge.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Merge represents merge instructions for combining imports",
      "properties": {
        "combine": {
          "$ref": "#/$defs/oscal.profile.v1.Combine.jsonschema.json"
        },
        "custom": {
          "$ref": "#/$defs/oscal.profile.v1.Custom.jsonschema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.json"
          },
          "type": "array"
        }
      },
      "title": "Merge",
      "type": "object"
    }
  },
  "$id": "oscal.profile.v1.Merge.jsonschema.bundle.json",
  "$ref": "#/$defs/oscal.profile.v1.Merge.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
