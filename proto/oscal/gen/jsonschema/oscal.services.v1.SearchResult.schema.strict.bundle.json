{
  "$defs": {
    "oscal.common.v1.UUID.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "UUID",
      "type": "object"
    },
    "oscal.services.v1.SearchResult.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "model_type": {
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ],
              "type": "string"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.strict.json"
        }
      },
      "required": [
        "model_type",
        "title",
        "score"
      ],
      "title": "Search Result",
      "type": "object"
    }
  },
  "$id": "oscal.services.v1.SearchResult.schema.strict.bundle.json",
  "$ref": "#/$defs/oscal.services.v1.SearchResult.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
