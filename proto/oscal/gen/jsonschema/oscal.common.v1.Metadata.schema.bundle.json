    "oscal.common.v1.EmailAddress.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "EmailAddress represents an email address",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Email Address",
      "type": "object"
    },
    "oscal.common.v1.Link.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
