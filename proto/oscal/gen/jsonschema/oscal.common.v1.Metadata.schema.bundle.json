        "^(emailAddresses)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.EmailAddress.schema.json"
          },
          "type": "array"
        },
        "^(telephoneNumbers)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.TelephoneNumber.schema.json"
          },
          "type": "array"
