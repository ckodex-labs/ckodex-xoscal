{
  "$defs": {
    "oscal.common.v1.Link.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.strict.json"
        },
        "media_type": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "resource_fragment": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "rel",
        "media_type",
        "text",
        "resource_fragment"
      ],
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ns": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "class",
        "id",
        "ns"
      ],
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.URIReference.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URIReference represents a URI reference (may be relative)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "URI Reference",
      "type": "object"
    },
    "oscal.common.v1.UUID.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "UUID",
      "type": "object"
    },
    "oscal.component_definition.v1.Capability.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Capability represents a grouping of control implementations",
      "properties": {
        "control_implementations": {
          "items": {
            "$ref": "#/$defs/oscal.component_definition.v1.ControlImplementation.schema.strict.json"
          },
          "type": "array"
        },
        "description": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.strict.json"
        }
      },
      "required": [
        "name"
      ],
      "title": "Capability",
      "type": "object"
    },
    "oscal.component_definition.v1.ControlImplementation.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ControlImplementation represents control implementation by a component",
      "properties": {
        "description": {
          "type": "string"
        },
        "implemented_requirements": {
          "items": {
            "$ref": "#/$defs/oscal.component_definition.v1.ImplementedRequirement.schema.strict.json"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "set_parameters": {
          "items": {
            "$ref": "#/$defs/oscal.component_definition.v1.SetParameter.schema.strict.json"
          },
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/oscal.common.v1.URIReference.schema.strict.json"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.strict.json"
        }
      },
      "required": [
        "description"
      ],
      "title": "Control Implementation",
      "type": "object"
    },
    "oscal.component_definition.v1.ImplementedRequirement.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ImplementedRequirement represents a control requirement implementation",
      "properties": {
        "control_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "statements": {
          "items": {
            "$ref": "#/$defs/oscal.component_definition.v1.Statement.schema.strict.json"
          },
          "type": "array"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.strict.json"
        }
      },
      "required": [
        "control_id",
        "description"
      ],
      "title": "Implemented Requirement",
      "type": "object"
    },
    "oscal.component_definition.v1.SetParameter.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SetParameter represents parameter value assignments",
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "param_id": {
          "type": "string"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.strict.json"
          },
          "type": "array"
        }
      },
      "required": [
        "param_id"
      ],
      "title": "Set Parameter",
      "type": "object"
    },
    "oscal.component_definition.v1.Statement.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Statement represents a control implementation statement",
      "properties": {
        "by_components": {
          "items": {
            "$ref": "#/$defs/oscal.component_definition.v1.Statement.schema.strict.json"
          },
          "type": "array"
        },
        "description": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.strict.json"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
          },
          "type": "array"
        },
        "statement_id": {
          "type": "string"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "statement_id",
        "uuid"
      ],
      "title": "Statement",
      "type": "object"
    }
  },
  "$id": "oscal.component_definition.v1.Capability.schema.strict.bundle.json",
  "$ref": "#/$defs/oscal.component_definition.v1.Capability.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
