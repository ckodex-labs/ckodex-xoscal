      "$ref": "oscal.common.v1.BackMatter.schema.json"
    },
    "import_ap": {
      "$ref": "oscal.assessment_results.v1.ImportAp.schema.json"
    },
    "import_ssp": {
      "$ref": "oscal.assessment_results.v1.ImportSsp.schema.json"
