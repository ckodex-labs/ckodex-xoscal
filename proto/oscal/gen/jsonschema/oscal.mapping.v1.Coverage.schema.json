{
  "$id": "oscal.mapping.v1.Coverage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Coverage records target coverage and the method used to derive it.\n Fields 1-5 are retained for wire compatibility with the prototype model.",
  "patternProperties": {
    "^(generationMethod)$": {
      "default": "",
      "type": "string"
    },
    "^(targetCoverage)$": {
      "$ref": "oscal.common.v1.Decimal.schema.json"
    }
  },
  "properties": {
    "generation_method": {
      "default": "",
      "type": "string"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.json"
      },
      "type": "array"
    },
    "method": {
      "default": "",
      "type": "string"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
      },
      "type": "array"
    },
    "target_coverage": {
      "$ref": "oscal.common.v1.Decimal.schema.json"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "default": 0
    }
  },
  "title": "Coverage",
  "type": "object"
}
