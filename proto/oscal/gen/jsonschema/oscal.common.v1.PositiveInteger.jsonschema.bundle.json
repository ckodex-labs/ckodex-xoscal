{
  "$defs": {
    "oscal.common.v1.PositiveInteger.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "PositiveInteger represents a positive integer",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "title": "Positive Integer",
      "type": "object"
    }
  },
  "$id": "oscal.common.v1.PositiveInteger.jsonschema.bundle.json",
  "$ref": "#/$defs/oscal.common.v1.PositiveInteger.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
