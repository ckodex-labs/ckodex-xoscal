{
  "$defs": {
    "google.protobuf.Timestamp.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "oscal.services.v1.GraphEdge.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "evidence_digest": {
          "type": "string"
        },
        "extensions_json": {
          "type": "string"
        },
        "from_node": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "proof_state": {
          "$ref": "#/$defs/oscal.services.v1.ProofState.schema.strict.json"
        },
        "qualifier": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "to_node": {
          "type": "string"
        },
        "trust_state": {
          "type": "string"
        },
        "valid_time": {
          "$ref": "#/$defs/oscal.services.v1.TimeWindow.schema.strict.json"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ],
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "id",
        "from_node",
        "to_node",
        "relation",
        "qualifier",
        "claim_id",
        "evidence_digest",
        "trust_state",
        "weight",
        "extensions_json"
      ],
      "title": "Graph Edge",
      "type": "object"
    },
    "oscal.services.v1.ListEdgesResponse.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/oscal.services.v1.GraphEdge.schema.strict.json"
          },
          "type": "array"
        },
        "next_page_token": {
          "type": "string"
        }
      },
      "required": [
        "next_page_token"
      ],
      "title": "List Edges Response",
      "type": "object"
    },
    "oscal.services.v1.ProofState.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string"
        },
        "discovery": {
          "type": "string"
        },
        "graph": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "transparency": {
          "type": "string"
        },
        "witness_json": {
          "type": "string"
        }
      },
      "required": [
        "discovery",
        "graph",
        "claim",
        "source",
        "signature",
        "transparency",
        "witness_json",
        "state",
        "policy"
      ],
      "title": "Proof State",
      "type": "object"
    },
    "oscal.services.v1.TimeWindow.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "from_time": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.strict.json"
        },
        "to_time": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.strict.json"
        }
      },
      "title": "Time Window",
      "type": "object"
    }
  },
  "$id": "oscal.services.v1.ListEdgesResponse.schema.strict.bundle.json",
  "$ref": "#/$defs/oscal.services.v1.ListEdgesResponse.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
