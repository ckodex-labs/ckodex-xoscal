{
  "$defs": {
    "oscal.common.v1.Base64.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Base64 represents base64-encoded binary data",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Base64",
      "type": "object"
    },
    "oscal.common.v1.Hash.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Hash represents a cryptographic hash",
      "properties": {
        "algorithm": {
          "default": "",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/oscal.common.v1.Base64.schema.json"
        }
      },
      "title": "Hash",
      "type": "object"
    },
    "oscal.common.v1.Rlink.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Rlink represents a resource link",
      "patternProperties": {
        "^(mediaType)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "hashes": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Hash.schema.json"
          },
          "type": "array"
        },
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.json"
        },
        "media_type": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Rlink",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    }
  },
  "$id": "oscal.common.v1.Rlink.schema.bundle.json",
  "$ref": "#/$defs/oscal.common.v1.Rlink.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
