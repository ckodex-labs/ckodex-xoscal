{
  "$defs": {
    "oscal.common.v1.UUID.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "UUID",
      "type": "object"
    },
    "oscal.services.v1.SearchResult.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(model_type)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "modelType": {
          "default": "",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ],
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "default": 0
        },
        "title": {
          "default": "",
          "type": "string"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
        }
      },
      "title": "Search Result",
      "type": "object"
    }
  },
  "$id": "oscal.services.v1.SearchResult.jsonschema.bundle.json",
  "$ref": "#/$defs/oscal.services.v1.SearchResult.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
