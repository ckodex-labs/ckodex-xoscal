{
  "$id": "oscal.poam.v1.Response.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Response represents a risk response/remediation",
  "patternProperties": {
    "^(related_tasks)$": {
      "items": {
        "$ref": "oscal.poam.v1.RelatedTask.jsonschema.json"
      },
      "type": "array"
    },
    "^(responsible_roles)$": {
      "items": {
        "$ref": "oscal.poam.v1.ResponsibleRole.jsonschema.json"
      },
      "type": "array"
    }
  },
  "properties": {
    "deadline": {
      "$ref": "oscal.common.v1.DateTime.jsonschema.json"
    },
    "description": {
      "$ref": "oscal.common.v1.MarkupMultiline.jsonschema.json"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.jsonschema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.jsonschema.json"
      },
      "type": "array"
    },
    "relatedTasks": {
      "items": {
        "$ref": "oscal.poam.v1.RelatedTask.jsonschema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.jsonschema.json"
      },
      "type": "array"
    },
    "responsibleRoles": {
      "items": {
        "$ref": "oscal.poam.v1.ResponsibleRole.jsonschema.json"
      },
      "type": "array"
    },
    "status": {
      "$ref": "oscal.poam.v1.ResponseStatus.jsonschema.json"
    },
    "subjects": {
      "items": {
        "$ref": "oscal.poam.v1.SubjectReference.jsonschema.json"
      },
      "type": "array"
    },
    "title": {
      "$ref": "oscal.common.v1.MarkupLine.jsonschema.json"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.jsonschema.json"
    }
  },
  "title": "Response",
  "type": "object"
}
