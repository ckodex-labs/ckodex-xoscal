{
  "$id": "oscal.common.v1.Location.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Location represents a physical or virtual location",
  "patternProperties": {
    "^(email_addresses)$": {
      "items": {
        "$ref": "oscal.common.v1.EmailAddress.jsonschema.json"
      },
      "type": "array"
    },
    "^(telephone_numbers)$": {
      "items": {
        "$ref": "oscal.common.v1.TelephoneNumber.jsonschema.json"
      },
      "type": "array"
    }
  },
  "properties": {
    "address": {
      "$ref": "oscal.common.v1.Address.jsonschema.json"
    },
    "emailAddresses": {
      "items": {
        "$ref": "oscal.common.v1.EmailAddress.jsonschema.json"
      },
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.jsonschema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.jsonschema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.jsonschema.json"
      },
      "type": "array"
    },
    "telephoneNumbers": {
      "items": {
        "$ref": "oscal.common.v1.TelephoneNumber.jsonschema.json"
      },
      "type": "array"
    },
    "title": {
      "default": "",
      "type": "string"
    },
    "urls": {
      "items": {
        "$ref": "oscal.common.v1.URI.jsonschema.json"
      },
      "type": "array"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.jsonschema.json"
    }
  },
  "title": "Location",
  "type": "object"
}
