{
  "$defs": {
    "oscal.catalog.v1.Constraint.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Constraint represents a constraint on a parameter value",
      "properties": {
        "description": {
          "type": "string"
        },
        "tests": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Test.jsonschema.strict.json"
          },
          "type": "array"
        }
      },
      "required": [
        "description"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "oscal.catalog.v1.Guideline.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Guideline represents a parameter guideline",
      "properties": {
        "prose": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
        }
      },
      "title": "Guideline",
      "type": "object"
    },
    "oscal.catalog.v1.Parameter.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameter represents a control parameter",
      "properties": {
        "class": {
          "type": "string"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Constraint.jsonschema.strict.json"
          },
          "type": "array"
        },
        "guidance": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.strict.json",
          "description": "Deprecated: use guidelines instead. Kept for backward compatibility."
        },
        "guidelines": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Guideline.jsonschema.strict.json"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/oscal.common.v1.Token.jsonschema.strict.json"
        },
        "label": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.strict.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
          },
          "type": "array"
        },
        "select": {
          "$ref": "#/$defs/oscal.catalog.v1.Select.jsonschema.strict.json"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.strict.json"
          },
          "type": "array"
        }
      },
      "required": [
        "class"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "oscal.catalog.v1.Select.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Select represents a selection of parameter values",
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.strict.json"
          },
          "type": "array"
        },
        "howMany": {
          "type": "boolean"
        }
      },
      "required": [
        "howMany"
      ],
      "title": "Select",
      "type": "object"
    },
    "oscal.catalog.v1.Test.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Test represents a constraint test",
      "properties": {
        "expression": {
          "type": "string"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
          },
          "type": "array"
        }
      },
      "required": [
        "expression"
      ],
      "title": "Test",
      "type": "object"
    },
    "oscal.common.v1.Link.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.jsonschema.strict.json"
        },
        "mediaType": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "resourceFragment": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "rel",
        "mediaType",
        "text",
        "resourceFragment"
      ],
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "class",
        "id"
      ],
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.Token.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Token represents an alphanumeric token (e.g., control IDs)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Token",
      "type": "object"
    },
    "oscal.common.v1.URI.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "URI",
      "type": "object"
    }
  },
  "$id": "oscal.catalog.v1.Parameter.jsonschema.strict.bundle.json",
  "$ref": "#/$defs/oscal.catalog.v1.Parameter.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
