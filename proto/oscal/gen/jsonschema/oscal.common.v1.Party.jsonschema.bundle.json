{
  "$defs": {
    "oscal.common.v1.AddrLine.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "AddrLine represents a line of an address",
      "properties": {
        "value": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.json"
        }
      },
      "title": "Addr Line",
      "type": "object"
    },
    "oscal.common.v1.Address.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Address represents a postal address",
      "patternProperties": {
        "^(addr_lines)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.AddrLine.jsonschema.json"
          },
          "type": "array"
        },
        "^(postal_code)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "addrLines": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.AddrLine.jsonschema.json"
          },
          "type": "array"
        },
        "city": {
          "default": "",
          "type": "string"
        },
        "country": {
          "default": "",
          "type": "string"
        },
        "postalCode": {
          "default": "",
          "type": "string"
        },
        "state": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Address",
      "type": "object"
    },
    "oscal.common.v1.EmailAddress.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "EmailAddress represents an email address",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Email Address",
      "type": "object"
    },
    "oscal.common.v1.Link.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(media_type)$": {
          "default": "",
          "type": "string"
        },
        "^(resource_fragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.jsonschema.json"
        },
        "mediaType": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resourceFragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Party.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Party represents an organization or person",
      "patternProperties": {
        "^(email_addresses)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.EmailAddress.jsonschema.json"
          },
          "type": "array"
        },
        "^(external_ids)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.PartyExternalId.jsonschema.json"
          },
          "type": "array"
        },
        "^(location_uuids)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
          },
          "type": "array"
        },
        "^(responsible_parties)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.ResponsibleParty.jsonschema.json"
          },
          "type": "array"
        },
        "^(short_names)$": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "^(telephone_numbers)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.TelephoneNumber.jsonschema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "address": {
          "$ref": "#/$defs/oscal.common.v1.Address.jsonschema.json"
        },
        "emailAddresses": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.EmailAddress.jsonschema.json"
          },
          "type": "array"
        },
        "externalIds": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.PartyExternalId.jsonschema.json"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.json"
          },
          "type": "array"
        },
        "locationUuids": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
          },
          "type": "array"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "responsibleParties": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.ResponsibleParty.jsonschema.json"
          },
          "type": "array"
        },
        "shortNames": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "telephoneNumbers": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.TelephoneNumber.jsonschema.json"
          },
          "type": "array"
        },
        "type": {
          "default": "",
          "type": "string"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
        }
      },
      "title": "Party",
      "type": "object"
    },
    "oscal.common.v1.PartyExternalId.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "PartyExternalId represents an external identifier for a party",
      "properties": {
        "id": {
          "default": "",
          "type": "string"
        },
        "scheme": {
          "$ref": "#/$defs/oscal.common.v1.URI.jsonschema.json"
        }
      },
      "title": "Party External Id",
      "type": "object"
    },
    "oscal.common.v1.Property.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "ns": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.ResponsibleParty.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ResponsibleParty represents a party responsible for a role",
      "patternProperties": {
        "^(party_uuids)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
          },
          "type": "array"
        },
        "^(role_id)$": {
          "$ref": "#/$defs/oscal.common.v1.Token.jsonschema.json"
        }
      },
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.json"
          },
          "type": "array"
        },
        "partyUuids": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.json"
          },
          "type": "array"
        },
        "remarks": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.json"
        },
        "roleId": {
          "$ref": "#/$defs/oscal.common.v1.Token.jsonschema.json"
        }
      },
      "title": "Responsible Party",
      "type": "object"
    },
    "oscal.common.v1.TelephoneNumber.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "TelephoneNumber represents a telephone number",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Telephone Number",
      "type": "object"
    },
    "oscal.common.v1.Token.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Token represents an alphanumeric token (e.g., control IDs)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Token",
      "type": "object"
    },
    "oscal.common.v1.URI.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "UUID",
      "type": "object"
    }
  },
  "$id": "oscal.common.v1.Party.jsonschema.bundle.json",
  "$ref": "#/$defs/oscal.common.v1.Party.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
