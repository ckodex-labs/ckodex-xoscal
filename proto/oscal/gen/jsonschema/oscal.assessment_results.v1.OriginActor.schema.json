{
  "$id": "oscal.assessment_results.v1.OriginActor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "OriginActor represents an originating actor",
  "patternProperties": {
    "^(actorUuid)$": {
      "$ref": "oscal.common.v1.UUID.schema.json"
    }
  },
  "properties": {
    "actor_uuid": {
      "$ref": "oscal.common.v1.UUID.schema.json"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
      },
      "type": "array"
    },
    "title": {
      "$ref": "oscal.common.v1.MarkupLine.schema.json"
    }
  },
  "title": "Origin Actor",
  "type": "object"
}
