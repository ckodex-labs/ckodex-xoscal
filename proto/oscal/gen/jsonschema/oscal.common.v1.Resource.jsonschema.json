{
  "$id": "oscal.common.v1.Resource.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Resource represents an external resource",
  "patternProperties": {
    "^(citation_obj)$": {
      "$ref": "oscal.common.v1.Citation.jsonschema.json"
    },
    "^(document_ids)$": {
      "items": {
        "$ref": "oscal.common.v1.DocumentId.jsonschema.json"
      },
      "type": "array"
    }
  },
  "properties": {
    "base64": {
      "items": {
        "$ref": "oscal.common.v1.Base64.jsonschema.json"
      },
      "type": "array"
    },
    "citation": {
      "default": "",
      "description": "Deprecated: use citation_obj instead. Kept for backward compatibility.",
      "type": "string"
    },
    "citationObj": {
      "$ref": "oscal.common.v1.Citation.jsonschema.json"
    },
    "description": {
      "$ref": "oscal.common.v1.MarkupMultiline.jsonschema.json"
    },
    "documentIds": {
      "items": {
        "$ref": "oscal.common.v1.DocumentId.jsonschema.json"
      },
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.jsonschema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.jsonschema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "rlinks": {
      "items": {
        "$ref": "oscal.common.v1.Rlink.jsonschema.json"
      },
      "type": "array"
    },
    "title": {
      "default": "",
      "type": "string"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.jsonschema.json"
    }
  },
  "title": "Resource",
  "type": "object"
}
