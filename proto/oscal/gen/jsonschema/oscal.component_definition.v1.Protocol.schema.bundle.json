{
  "$defs": {
    "oscal.common.v1.Link.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(mediaType)$": {
          "default": "",
          "type": "string"
        },
        "^(resourceFragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.json"
        },
        "media_type": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resource_fragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "UUID",
      "type": "object"
    },
    "oscal.component_definition.v1.Protocol.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Protocol represents a protocol used by the component",
      "patternProperties": {
        "^(portNumbers)$": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "properties": {
        "description": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "port_numbers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "title": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
          },
          "type": "array"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Protocol",
      "type": "object"
    }
  },
  "$id": "oscal.component_definition.v1.Protocol.schema.bundle.json",
  "$ref": "#/$defs/oscal.component_definition.v1.Protocol.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
