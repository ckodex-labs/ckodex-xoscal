{
  "$defs": {
    "oscal.common.v1.Link.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.jsonschema.strict.json"
        },
        "mediaType": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "resourceFragment": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "rel",
        "mediaType",
        "text",
        "resourceFragment"
      ],
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ns": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "class",
        "id",
        "ns"
      ],
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.URI.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "UUID",
      "type": "object"
    },
    "oscal.ssp.v1.Categorization.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Categorization represents an information type categorization",
      "properties": {
        "informationTypeIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "system": {
          "type": "string"
        }
      },
      "required": [
        "system"
      ],
      "title": "Categorization",
      "type": "object"
    },
    "oscal.ssp.v1.Impact.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Impact represents an impact level",
      "properties": {
        "adjustmentJustification": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
        },
        "base": {
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.strict.json"
          },
          "type": "array"
        },
        "selected": {
          "type": "string"
        }
      },
      "required": [
        "base",
        "selected"
      ],
      "title": "Impact",
      "type": "object"
    },
    "oscal.ssp.v1.InformationType.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "InformationType represents an information type",
      "properties": {
        "availabilityImpact": {
          "$ref": "#/$defs/oscal.ssp.v1.Impact.jsonschema.strict.json"
        },
        "categorizations": {
          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.Categorization.jsonschema.strict.json"
          },
          "type": "array"
        },
        "confidentialityImpact": {
          "$ref": "#/$defs/oscal.ssp.v1.Impact.jsonschema.strict.json"
        },
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
        },
        "integrityImpact": {
          "$ref": "#/$defs/oscal.ssp.v1.Impact.jsonschema.strict.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.jsonschema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.jsonschema.strict.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.jsonschema.strict.json"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.jsonschema.strict.json"
        }
      },
      "title": "Information Type",
      "type": "object"
    }
  },
  "$id": "oscal.ssp.v1.InformationType.jsonschema.strict.bundle.json",
  "$ref": "#/$defs/oscal.ssp.v1.InformationType.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
