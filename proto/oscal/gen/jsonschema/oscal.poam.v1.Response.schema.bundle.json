{
  "$defs": {
    "google.protobuf.Timestamp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "oscal.common.v1.DateTime.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "DateTime represents a date-time with timezone (RFC3339)",
      "properties": {
        "value": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        }
      },
      "title": "Date Time",
      "type": "object"
    },
    "oscal.common.v1.Link.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(mediaType)$": {
          "default": "",
          "type": "string"
        },
        "^(resourceFragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.json"
        },
        "media_type": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resource_fragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "ns": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.Token.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Token represents an alphanumeric token (e.g., control IDs)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Token",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "UUID",
      "type": "object"
    },
    "oscal.poam.v1.RelatedTask.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelatedTask represents a related task",
      "patternProperties": {
        "^(taskUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "task_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        }
      },
      "title": "Related Task",
      "type": "object"
    },
    "oscal.poam.v1.Response.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Response represents a risk response/remediation",
      "patternProperties": {
        "^(relatedTasks)$": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedTask.schema.json"
          },
          "type": "array"
        },
        "^(responsibleRoles)$": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.ResponsibleRole.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "deadline": {
          "$ref": "#/$defs/oscal.common.v1.DateTime.schema.json"
        },
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "related_tasks": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedTask.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "responsible_roles": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.ResponsibleRole.schema.json"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/oscal.poam.v1.ResponseStatus.schema.json"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.SubjectReference.schema.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Response",
      "type": "object"
    },
    "oscal.poam.v1.ResponseStatus.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ResponseStatus represents response status",
      "properties": {
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "state": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Response Status",
      "type": "object"
    },
    "oscal.poam.v1.ResponsibleRole.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ResponsibleRole represents a responsible role",
      "patternProperties": {
        "^(partyUuids)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
          },
          "type": "array"
        },
        "^(roleId)$": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
        }
      },
      "properties": {
        "party_uuids": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "role_id": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
        }
      },
      "title": "Responsible Role",
      "type": "object"
    },
    "oscal.poam.v1.SubjectReference.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SubjectReference represents a subject reference",
      "patternProperties": {
        "^(subjectUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "subject_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        }
      },
      "title": "Subject Reference",
      "type": "object"
    }
  },
  "$id": "oscal.poam.v1.Response.schema.bundle.json",
  "$ref": "#/$defs/oscal.poam.v1.Response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
