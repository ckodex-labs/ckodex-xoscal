{
  "$defs": {
    "oscal.services.v1.ProofState.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(witnessJson)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "claim": {
          "default": "",
          "type": "string"
        },
        "discovery": {
          "default": "",
          "type": "string"
        },
        "graph": {
          "default": "",
          "type": "string"
        },
        "policy": {
          "default": "",
          "type": "string"
        },
        "signature": {
          "default": "",
          "type": "string"
        },
        "source": {
          "default": "",
          "type": "string"
        },
        "state": {
          "default": "",
          "type": "string"
        },
        "transparency": {
          "default": "",
          "type": "string"
        },
        "witness_json": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Proof State",
      "type": "object"
    },
    "oscal.services.v1.VerifyClaimResponse.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(claimId)$": {
          "default": "",
          "type": "string"
        },
        "^(proofState)$": {
          "$ref": "#/$defs/oscal.services.v1.ProofState.schema.json"
        },
        "^(trustState)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "claim_id": {
          "default": "",
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "proof_state": {
          "$ref": "#/$defs/oscal.services.v1.ProofState.schema.json"
        },
        "trust_state": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Verify Claim Response",
      "type": "object"
    }
  },
  "$id": "oscal.services.v1.VerifyClaimResponse.schema.bundle.json",
  "$ref": "#/$defs/oscal.services.v1.VerifyClaimResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
