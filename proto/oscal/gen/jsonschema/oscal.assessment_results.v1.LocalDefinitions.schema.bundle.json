        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Component",
      "type": "object"
    },
    "oscal.assessment_results.v1.InventoryItem.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
