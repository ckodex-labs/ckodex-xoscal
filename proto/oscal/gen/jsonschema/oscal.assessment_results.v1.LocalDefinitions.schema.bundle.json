    "oscal.assessment_results.v1.LocalDefinitions.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "LocalDefinitions represents local definitions for assessment results",
      "patternProperties": {
        "^(assessmentPlatforms)$": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.AssessmentPlatform.schema.json"
          },
          "type": "array"
        },
        "^(inventoryItems)$": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.InventoryItem.schema.json"
          },
          "type": "array"
