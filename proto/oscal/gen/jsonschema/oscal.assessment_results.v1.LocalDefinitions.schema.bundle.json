{
  "$defs": {
    "oscal.assessment_results.v1.AssessmentPlatform.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "AssessmentPlatform represents an assessment platform",
      "patternProperties": {
        "^(usesComponents)$": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.UsesComponent.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "uses_components": {
          "items": {
            "$ref": "#/$defs/oscal.assessment_results.v1.UsesComponent.schema.json"
          },
          "type": "array"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Assessment Platform",
      "type": "object"
    },
    "oscal.assessment_results.v1.Component.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
