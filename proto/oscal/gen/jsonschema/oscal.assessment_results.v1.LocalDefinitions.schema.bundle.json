    "oscal.assessment_results.v1.UsesComponent.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UsesComponent represents a component used by the assessment platform",
      "patternProperties": {
        "^(componentUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "^(responsibleParties)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.ResponsibleParty.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "component_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
