    "oscal.common.v1.Link.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(mediaType)$": {
          "default": "",
