{
  "$id": "oscal.poam.v1.SubjectReference.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "SubjectReference represents a subject reference",
  "patternProperties": {
    "^(subjectUuid)$": {
      "$ref": "oscal.common.v1.UUID.schema.json"
    }
  },
  "properties": {
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
      },
      "type": "array"
    },
    "subject_uuid": {
      "$ref": "oscal.common.v1.UUID.schema.json"
    },
    "title": {
      "$ref": "oscal.common.v1.MarkupLine.schema.json"
    }
  },
  "title": "Subject Reference",
  "type": "object"
}
