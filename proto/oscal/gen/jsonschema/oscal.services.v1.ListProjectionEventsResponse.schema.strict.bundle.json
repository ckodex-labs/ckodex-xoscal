{
  "$defs": {
    "google.protobuf.Timestamp.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "oscal.services.v1.GraphProjectionEvent.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "GraphProjectionEvent is an append-only, hash-chained audit record emitted\n in the same transaction as a successful edge projection.",
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "edge_id": {
          "type": "string"
        },
        "event_hash": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "evidence_digest": {
          "type": "string"
        },
        "from_node": {
          "type": "string"
        },
        "previous_hash": {
          "type": "string"
        },
        "projected_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.strict.json"
        },
        "relation": {
          "type": "string"
        },
        "sequence": {
          "type": "integer"
        },
        "to_node": {
          "type": "string"
        },
        "trust_state": {
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "event_id",
        "edge_id",
        "claim_id",
        "from_node",
        "to_node",
        "relation",
        "evidence_digest",
        "trust_state",
        "previous_hash",
        "event_hash"
      ],
      "title": "Graph Projection Event",
      "type": "object"
    },
    "oscal.services.v1.ListProjectionEventsResponse.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "chain_valid": {
          "type": "boolean"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/oscal.services.v1.GraphProjectionEvent.schema.strict.json"
          },
          "type": "array"
        }
      },
      "required": [
        "chain_valid"
      ],
      "title": "List Projection Events Response",
      "type": "object"
    }
  },
  "$id": "oscal.services.v1.ListProjectionEventsResponse.schema.strict.bundle.json",
  "$ref": "#/$defs/oscal.services.v1.ListProjectionEventsResponse.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
