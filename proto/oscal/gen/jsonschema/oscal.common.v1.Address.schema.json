{
  "$id": "oscal.common.v1.Address.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Address represents a postal address",
  "patternProperties": {
    "^(addrLines)$": {
      "items": {
        "$ref": "oscal.common.v1.AddrLine.schema.json"
      },
      "type": "array"
    },
    "^(postalCode)$": {
      "default": "",
      "type": "string"
    }
  },
  "properties": {
    "addr_lines": {
      "items": {
        "$ref": "oscal.common.v1.AddrLine.schema.json"
      },
      "type": "array"
    },
    "city": {
      "default": "",
      "type": "string"
    },
    "country": {
      "default": "",
      "type": "string"
    },
    "postal_code": {
      "default": "",
      "type": "string"
    },
    "state": {
      "default": "",
      "type": "string"
    }
  },
  "title": "Address",
  "type": "object"
}
