{
  "$id": "oscal.mapping.v1.MappingProvenance.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "MappingProvenance records how the collection was produced and its status.",
  "properties": {
    "confidenceScore": {
      "$ref": "oscal.mapping.v1.ConfidenceScore.jsonschema.strict.json"
    },
    "coverage": {
      "$ref": "oscal.mapping.v1.Coverage.jsonschema.strict.json"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.jsonschema.strict.json"
      },
      "type": "array"
    },
    "mappingDescription": {
      "$ref": "oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
    },
    "matchingRationale": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.jsonschema.strict.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.jsonschema.strict.json"
      },
      "type": "array"
    },
    "responsibleParties": {
      "items": {
        "$ref": "oscal.common.v1.ResponsibleParty.jsonschema.strict.json"
      },
      "type": "array"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "method",
    "matchingRationale",
    "status"
  ],
  "title": "Mapping Provenance",
  "type": "object"
}
