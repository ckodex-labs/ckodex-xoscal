{
  "$defs": {
    "oscal.common.v1.BackMatter.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "BackMatter represents appendices and resources",
      "properties": {
        "resources": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Resource.schema.strict.json"
          },
          "type": "array"
        }
      },
      "title": "Back Matter",
      "type": "object"
    },
    "oscal.common.v1.Base64.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Base64 represents base64-encoded binary data",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Base64",
      "type": "object"
    },
    "oscal.common.v1.Citation.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Citation represents a bibliographic citation",
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "text": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.strict.json"
        }
      },
      "title": "Citation",
      "type": "object"
    },
    "oscal.common.v1.DocumentId.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "DocumentId represents a document identifier",
      "properties": {
        "identifier": {
          "type": "string"
        },
        "scheme": {
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "identifier"
      ],
      "title": "Document Id",
      "type": "object"
    },
    "oscal.common.v1.Hash.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Hash represents a cryptographic hash",
      "properties": {
        "algorithm": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/oscal.common.v1.Base64.schema.strict.json"
        }
      },
      "required": [
        "algorithm"
      ],
      "title": "Hash",
      "type": "object"
    },
    "oscal.common.v1.Link.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.strict.json"
        },
        "media_type": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "resource_fragment": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "rel",
        "media_type",
        "text",
        "resource_fragment"
      ],
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "class",
        "id"
      ],
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.Resource.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Resource represents an external resource",
      "properties": {
        "base64": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Base64.schema.strict.json"
          },
          "type": "array"
        },
        "citation": {
          "description": "Deprecated: use citation_obj instead. Kept for backward compatibility.",
          "type": "string"
        },
        "citation_obj": {
          "$ref": "#/$defs/oscal.common.v1.Citation.schema.strict.json"
        },
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
        },
        "document_ids": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.DocumentId.schema.strict.json"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rlinks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Rlink.schema.strict.json"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.strict.json"
        }
      },
      "required": [
        "title",
        "citation"
      ],
      "title": "Resource",
      "type": "object"
    },
    "oscal.common.v1.Rlink.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Rlink represents a resource link",
      "properties": {
        "hashes": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Hash.schema.strict.json"
          },
          "type": "array"
        },
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.strict.json"
        },
        "media_type": {
          "type": "string"
        }
      },
      "required": [
        "media_type"
      ],
      "title": "Rlink",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "UUID",
      "type": "object"
    }
  },
  "$id": "oscal.common.v1.BackMatter.schema.strict.bundle.json",
  "$ref": "#/$defs/oscal.common.v1.BackMatter.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
