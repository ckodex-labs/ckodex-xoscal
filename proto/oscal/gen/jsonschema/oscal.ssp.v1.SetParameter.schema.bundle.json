{
  "$defs": {
    "oscal.common.v1.MarkupLine.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Token.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Token represents an alphanumeric token (e.g., control IDs)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Token",
      "type": "object"
    },
    "oscal.ssp.v1.SetParameter.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SetParameter represents a set parameter",
      "patternProperties": {
        "^(paramId)$": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
        }
      },
      "properties": {
        "param_id": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "value": {
          "default": "",
          "description": "Deprecated: use values instead. Kept for backward compatibility.",
          "type": "string"
        },
        "values": {
          "description": "values is the OSCAL schema-required array of parameter values.",
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Set Parameter",
      "type": "object"
    }
  },
  "$id": "oscal.ssp.v1.SetParameter.schema.bundle.json",
  "$ref": "#/$defs/oscal.ssp.v1.SetParameter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
