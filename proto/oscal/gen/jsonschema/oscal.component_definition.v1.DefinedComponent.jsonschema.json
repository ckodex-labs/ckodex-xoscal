{
  "$id": "oscal.component_definition.v1.DefinedComponent.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "DefinedComponent represents a component description",
  "patternProperties": {
    "^(control_implementations)$": {
      "items": {
        "$ref": "oscal.component_definition.v1.ControlImplementation.jsonschema.json"
      },
      "type": "array"
    },
    "^(responsible_parties)$": {
      "items": {
        "$ref": "oscal.component_definition.v1.ResponsibleParty.jsonschema.json"
      },
      "type": "array"
    },
    "^(supply_chain_type)$": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "properties": {
    "controlImplementations": {
      "items": {
        "$ref": "oscal.component_definition.v1.ControlImplementation.jsonschema.json"
      },
      "type": "array"
    },
    "description": {
      "$ref": "oscal.common.v1.MarkupMultiline.jsonschema.json"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.jsonschema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.jsonschema.json"
      },
      "type": "array"
    },
    "protocols": {
      "items": {
        "$ref": "oscal.component_definition.v1.Protocol.jsonschema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.jsonschema.json"
      },
      "type": "array"
    },
    "responsibleParties": {
      "items": {
        "$ref": "oscal.component_definition.v1.ResponsibleParty.jsonschema.json"
      },
      "type": "array"
    },
    "supplyChainType": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "$ref": "oscal.common.v1.MarkupLine.jsonschema.json"
    },
    "type": {
      "default": "",
      "type": "string"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.jsonschema.json"
    }
  },
  "title": "Defined Component",
  "type": "object"
}
