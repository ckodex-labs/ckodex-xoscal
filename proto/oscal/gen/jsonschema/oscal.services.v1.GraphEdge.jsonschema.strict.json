{
  "$id": "oscal.services.v1.GraphEdge.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimId": {
      "type": "string"
    },
    "evidenceDigest": {
      "type": "string"
    },
    "extensionsJson": {
      "type": "string"
    },
    "fromNode": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "proofState": {
      "$ref": "oscal.services.v1.ProofState.jsonschema.strict.json"
    },
    "qualifier": {
      "type": "string"
    },
    "relation": {
      "type": "string"
    },
    "toNode": {
      "type": "string"
    },
    "trustState": {
      "type": "string"
    },
    "validTime": {
      "$ref": "oscal.services.v1.TimeWindow.jsonschema.strict.json"
    },
    "weight": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ],
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "id",
    "fromNode",
    "toNode",
    "relation",
    "qualifier",
    "claimId",
    "evidenceDigest",
    "trustState",
    "weight",
    "extensionsJson"
  ],
  "title": "Graph Edge",
  "type": "object"
}
