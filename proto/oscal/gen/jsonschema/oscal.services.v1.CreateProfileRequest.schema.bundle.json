          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Guideline.schema.json"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
        },
        "label": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "select": {
          "$ref": "#/$defs/oscal.catalog.v1.Select.schema.json"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Parameter",
      "type": "object"
    },
    "oscal.catalog.v1.Part.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Part represents a part of a control (e.g., statement, objective)",
