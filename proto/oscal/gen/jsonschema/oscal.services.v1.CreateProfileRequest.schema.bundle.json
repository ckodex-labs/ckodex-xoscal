        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "ns": {
          "default": "",
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Part.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "prose": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        }
      },
      "title": "Part",
      "type": "object"
    },
    "oscal.catalog.v1.Select.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Select represents a selection of parameter values",
      "patternProperties": {
        "^(howMany)$": {
          "default": false,
          "type": "boolean"
        }
      },
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
          },
          "type": "array"
        },
        "how_many": {
          "default": false,
          "type": "boolean"
        }
      },
      "title": "Select",
      "type": "object"
    },
    "oscal.catalog.v1.Test.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Test represents a constraint test",
      "properties": {
        "expression": {
          "default": "",
          "type": "string"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Test",
      "type": "object"
    },
    "oscal.common.v1.AddrLine.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "AddrLine represents a line of an address",
      "properties": {
        "value": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        }
      },
      "title": "Addr Line",
      "type": "object"
    },
    "oscal.common.v1.Address.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Address represents a postal address",
      "patternProperties": {
        "^(addrLines)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.AddrLine.schema.json"
          },
          "type": "array"
        },
        "^(postalCode)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "addr_lines": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.AddrLine.schema.json"
          },
          "type": "array"
        },
        "city": {
          "default": "",
          "type": "string"
        },
        "country": {
          "default": "",
          "type": "string"
        },
        "postal_code": {
          "default": "",
          "type": "string"
        },
        "state": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Address",
      "type": "object"
    },
    "oscal.common.v1.BackMatter.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
