          "default": "",
          "type": "string"
        },
        "tests": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Test.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Constraint",
      "type": "object"
    },
    "oscal.catalog.v1.Control.schema.json": {
