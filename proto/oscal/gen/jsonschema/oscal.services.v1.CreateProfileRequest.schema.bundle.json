      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Metadata represents document metadata shared across all OSCAL models",
      "patternProperties": {
        "^(documentId)$": {
          "$ref": "#/$defs/oscal.common.v1.DocumentId.schema.json"
        },
        "^(lastModified)$": {
          "$ref": "#/$defs/oscal.common.v1.DateTime.schema.json"
        },
        "^(oscalVersion)$": {
          "default": "",
          "type": "string"
        },
        "^(responsibleParties)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.ResponsibleParty.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "document_id": {
          "$ref": "#/$defs/oscal.common.v1.DocumentId.schema.json"
        },
        "last_modified": {
          "$ref": "#/$defs/oscal.common.v1.DateTime.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Location.schema.json"
          },
          "type": "array"
        },
        "oscal_version": {
          "default": "",
          "type": "string"
        },
        "parties": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Party.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "published": {
          "$ref": "#/$defs/oscal.common.v1.DateTime.schema.json"
        },
        "remarks": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
        },
        "responsible_parties": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.ResponsibleParty.schema.json"
          },
          "type": "array"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Role.schema.json"
          },
          "type": "array"
        },
        "title": {
          "default": "",
          "type": "string"
        },
        "version": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "oscal.common.v1.Party.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Party represents an organization or person",
      "patternProperties": {
        "^(emailAddresses)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.EmailAddress.schema.json"
          },
          "type": "array"
        },
        "^(externalIds)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.PartyExternalId.schema.json"
          },
          "type": "array"
        },
        "^(locationUuids)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
          },
          "type": "array"
        },
        "^(responsibleParties)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.ResponsibleParty.schema.json"
          },
          "type": "array"
        },
        "^(shortNames)$": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "^(telephoneNumbers)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.TelephoneNumber.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "address": {
          "$ref": "#/$defs/oscal.common.v1.Address.schema.json"
        },
        "email_addresses": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.EmailAddress.schema.json"
          },
          "type": "array"
        },
        "external_ids": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.PartyExternalId.schema.json"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "location_uuids": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
          },
          "type": "array"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "responsible_parties": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.ResponsibleParty.schema.json"
          },
          "type": "array"
        },
        "short_names": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "telephone_numbers": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.TelephoneNumber.schema.json"
          },
          "type": "array"
        },
        "type": {
          "default": "",
          "type": "string"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Party",
      "type": "object"
    },
    "oscal.common.v1.PartyExternalId.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "PartyExternalId represents an external identifier for a party",
      "properties": {
        "id": {
          "default": "",
          "type": "string"
        },
        "scheme": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.json"
        }
      },
      "title": "Party External Id",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.Resource.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Resource represents an external resource",
      "patternProperties": {
        "^(citationObj)$": {
          "$ref": "#/$defs/oscal.common.v1.Citation.schema.json"
        },
        "^(documentIds)$": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.DocumentId.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "base64": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Base64.schema.json"
          },
          "type": "array"
        },
        "citation": {
          "default": "",
          "description": "Deprecated: use citation_obj instead. Kept for backward compatibility.",
          "type": "string"
        },
        "citation_obj": {
          "$ref": "#/$defs/oscal.common.v1.Citation.schema.json"
        },
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
        },
