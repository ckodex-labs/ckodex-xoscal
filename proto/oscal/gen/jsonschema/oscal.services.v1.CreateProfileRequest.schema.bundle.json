          "items": {
            "$ref": "#/$defs/oscal.common.v1.Resource.schema.json"
          },
          "type": "array"
        }
      },
      "title": "Back Matter",
      "type": "object"
    },
    "oscal.common.v1.Base64.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Base64 represents base64-encoded binary data",
      "properties": {
