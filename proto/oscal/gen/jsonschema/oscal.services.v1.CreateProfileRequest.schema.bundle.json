        }
      },
      "title": "Guideline",
      "type": "object"
    },
    "oscal.catalog.v1.Parameter.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Parameter represents a control parameter",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/oscal.catalog.v1.Constraint.schema.json"
          },
          "type": "array"
        },
        "guidance": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json",
          "description": "Deprecated: use guidelines instead. Kept for backward compatibility."
