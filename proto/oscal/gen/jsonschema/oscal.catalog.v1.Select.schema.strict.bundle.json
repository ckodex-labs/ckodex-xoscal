{
  "$defs": {
    "oscal.catalog.v1.Select.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Select represents a selection of parameter values",
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.strict.json"
          },
          "type": "array"
        },
        "how_many": {
          "type": "boolean"
        }
      },
      "required": [
        "how_many"
      ],
      "title": "Select",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Line",
      "type": "object"
    }
  },
  "$id": "oscal.catalog.v1.Select.schema.strict.bundle.json",
  "$ref": "#/$defs/oscal.catalog.v1.Select.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
