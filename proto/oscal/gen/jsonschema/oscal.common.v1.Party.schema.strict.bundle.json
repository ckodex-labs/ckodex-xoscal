{
  "$defs": {
    "oscal.common.v1.AddrLine.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "AddrLine represents a line of an address",
      "properties": {
        "value": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.strict.json"
        }
      },
      "title": "Addr Line",
      "type": "object"
    },
    "oscal.common.v1.Address.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Address represents a postal address",
      "properties": {
        "addr_lines": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.AddrLine.schema.strict.json"
          },
          "type": "array"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "city",
        "state",
        "postal_code",
        "country"
      ],
      "title": "Address",
      "type": "object"
    },
    "oscal.common.v1.EmailAddress.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "EmailAddress represents an email address",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Email Address",
      "type": "object"
    },
    "oscal.common.v1.Link.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.strict.json"
        },
        "media_type": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "resource_fragment": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "rel",
        "media_type",
        "text",
        "resource_fragment"
      ],
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Party.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Party represents an organization or person",
      "properties": {
        "address": {
          "$ref": "#/$defs/oscal.common.v1.Address.schema.strict.json"
        },
        "email_addresses": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.EmailAddress.schema.strict.json"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "responsible_parties": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.ResponsibleParty.schema.strict.json"
          },
          "type": "array"
        },
        "short_names": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "telephone_numbers": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.TelephoneNumber.schema.strict.json"
          },
          "type": "array"
        },
        "type": {
          "type": "string"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.strict.json"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "title": "Party",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "class",
        "id"
      ],
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.ResponsibleParty.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "ResponsibleParty represents a party responsible for a role",
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "party_uuids": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.UUID.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "remarks": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
        },
        "role_id": {
          "$ref": "#/$defs/oscal.common.v1.Token.schema.strict.json"
        }
      },
      "title": "Responsible Party",
      "type": "object"
    },
    "oscal.common.v1.TelephoneNumber.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "TelephoneNumber represents a telephone number",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Telephone Number",
      "type": "object"
    },
    "oscal.common.v1.Token.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Token represents an alphanumeric token (e.g., control IDs)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Token",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "UUID",
      "type": "object"
    }
  },
  "$id": "oscal.common.v1.Party.schema.strict.bundle.json",
  "$ref": "#/$defs/oscal.common.v1.Party.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
