{
  "$defs": {
    "google.protobuf.Timestamp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "oscal.common.v1.DateTime.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "DateTime represents a date-time with timezone (RFC3339)",
      "properties": {
        "value": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        }
      },
      "title": "Date Time",
      "type": "object"
    },
    "oscal.common.v1.Link.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(mediaType)$": {
          "default": "",
          "type": "string"
        },
        "^(resourceFragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.json"
        },
        "media_type": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resource_fragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "ns": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "UUID",
      "type": "object"
    },
    "oscal.poam.v1.LoggedBy.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "LoggedBy represents who logged the entry",
      "patternProperties": {
        "^(partyUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "party_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        }
      },
      "title": "Logged By",
      "type": "object"
    },
    "oscal.poam.v1.RelatedResponse.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelatedResponse represents a related risk response",
      "patternProperties": {
        "^(relatedTasks)$": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedTask.schema.json"
          },
          "type": "array"
        },
        "^(responseUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "related_tasks": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedTask.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "response_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Related Response",
      "type": "object"
    },
    "oscal.poam.v1.RelatedTask.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RelatedTask represents a related task",
      "patternProperties": {
        "^(taskUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "task_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        }
      },
      "title": "Related Task",
      "type": "object"
    },
    "oscal.poam.v1.RiskLogEntry.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RiskLogEntry represents a risk log entry",
      "patternProperties": {
        "^(loggedBy)$": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.LoggedBy.schema.json"
          },
          "type": "array"
        },
        "^(relatedResponses)$": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedResponse.schema.json"
          },
          "type": "array"
        },
        "^(statusChange)$": {
          "$ref": "#/$defs/oscal.poam.v1.RiskStatus.schema.json"
        }
      },
      "properties": {
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
        },
        "end": {
          "$ref": "#/$defs/oscal.common.v1.DateTime.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "logged_by": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.LoggedBy.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "related_responses": {
          "items": {
            "$ref": "#/$defs/oscal.poam.v1.RelatedResponse.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "start": {
          "$ref": "#/$defs/oscal.common.v1.DateTime.schema.json"
        },
        "status_change": {
          "$ref": "#/$defs/oscal.poam.v1.RiskStatus.schema.json"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Risk Log Entry",
      "type": "object"
    },
    "oscal.poam.v1.RiskStatus.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "RiskStatus represents risk status",
      "properties": {
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "state": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Risk Status",
      "type": "object"
    }
  },
  "$id": "oscal.poam.v1.RiskLogEntry.schema.bundle.json",
  "$ref": "#/$defs/oscal.poam.v1.RiskLogEntry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
