{
  "$id": "oscal.services.v1.SearchResult.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "patternProperties": {
    "^(model_type)$": {
      "default": "",
      "type": "string"
    }
  },
  "properties": {
    "modelType": {
      "default": "",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "default": 0
    },
    "title": {
      "default": "",
      "type": "string"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.jsonschema.json"
    }
  },
  "title": "Search Result",
  "type": "object"
}
