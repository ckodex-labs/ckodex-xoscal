          "default": "",
          "type": "string"
        },
        "eventId": {
          "default": "",
          "type": "string"
        },
        "idempotencyKey": {
          "default": "",
          "type": "string"
        },
        "previousHash": {
          "default": "",
          "type": "string"
        },
        "proofStateJson": {
          "default": "",
          "type": "string"
        },
        "providerStateJson": {
          "default": "",
          "type": "string"
        },
        "requestId": {
          "default": "",
          "type": "string"
        },
        "sequence": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
