          },
          "type": "array"
        }
      },
      "title": "List Verification Events Response",
      "type": "object"
    },
    "oscal.services.v1.VerificationEvent.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "VerificationEvent is an append-only audit record. The JSON fields preserve\n the exact provider and proof envelopes recorded by the verifier.",
      "patternProperties": {
        "^(checks_json)$": {
          "default": "",
          "type": "string"
        },
        "^(claim_id)$": {
          "default": "",
          "type": "string"
        },
        "^(created_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "^(event_hash)$": {
          "default": "",
          "type": "string"
        },
        "^(event_id)$": {
          "default": "",
          "type": "string"
        },
        "^(idempotency_key)$": {
          "default": "",
          "type": "string"
        },
        "^(previous_hash)$": {
          "default": "",
          "type": "string"
        },
        "^(proof_state_json)$": {
          "default": "",
          "type": "string"
        },
        "^(provider_state_json)$": {
          "default": "",
          "type": "string"
        },
        "^(request_id)$": {
          "default": "",
          "type": "string"
        },
        "^(trust_state)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "checksJson": {
          "default": "",
          "type": "string"
        },
        "claimId": {
          "default": "",
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "diagnostics": {
