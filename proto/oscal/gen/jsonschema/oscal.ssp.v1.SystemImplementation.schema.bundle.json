{
  "$defs": {
    "oscal.common.v1.Date.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Date represents a date without time",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Date",
      "type": "object"
    },
    "oscal.common.v1.Link.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "patternProperties": {
        "^(mediaType)$": {
          "default": "",
          "type": "string"
        },
        "^(resourceFragment)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.json"
        },
        "media_type": {
          "default": "",
          "type": "string"
        },
        "rel": {
          "default": "",
          "type": "string"
        },
        "resource_fragment": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "default": "",
          "type": "string"
        }
      },
      "title": "UUID",
      "type": "object"
    },
    "oscal.ssp.v1.InventoryItem.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "InventoryItem represents an inventory item",
      "properties": {
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Inventory Item",
      "type": "object"
    },
    "oscal.ssp.v1.LeveragedAuthorization.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "LeveragedAuthorization represents a leveraged authorization",
      "patternProperties": {
        "^(dateAuthorized)$": {
          "$ref": "#/$defs/oscal.common.v1.Date.schema.json"
        },
        "^(partyUuid)$": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "properties": {
        "date_authorized": {
          "$ref": "#/$defs/oscal.common.v1.Date.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "party_uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.json"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "Leveraged Authorization",
      "type": "object"
    },
    "oscal.ssp.v1.Status.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Status represents system status",
      "properties": {
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "state": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Status",
      "type": "object"
    },
    "oscal.ssp.v1.SystemComponent.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SystemComponent represents a system component",
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/oscal.ssp.v1.Status.schema.json"
        },
        "title": {
          "default": "",
          "type": "string"
        },
        "type": {
          "default": "",
          "type": "string"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "System Component",
      "type": "object"
    },
    "oscal.ssp.v1.SystemImplementation.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SystemImplementation represents system implementation",
      "patternProperties": {
        "^(inventoryItems)$": {
          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.InventoryItem.schema.json"
          },
          "type": "array"
        },
        "^(leveragedAuthorizations)$": {
          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.LeveragedAuthorization.schema.json"
          },
          "type": "array"
        }
      },
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.SystemComponent.schema.json"
          },
          "type": "array"
        },
        "inventory_items": {
          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.InventoryItem.schema.json"
          },
          "type": "array"
        },
        "leveraged_authorizations": {
          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.LeveragedAuthorization.schema.json"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "users": {
          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.SystemUser.schema.json"
          },
          "type": "array"
        }
      },
      "title": "System Implementation",
      "type": "object"
    },
    "oscal.ssp.v1.SystemUser.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SystemUser represents a system user",
      "patternProperties": {
        "^(shortName)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.json"
          },
          "type": "array"
        },
        "remarks": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.json"
          },
          "type": "array"
        },
        "short_name": {
          "default": "",
          "type": "string"
        },
        "title": {
          "default": "",
          "type": "string"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.json"
        }
      },
      "title": "System User",
      "type": "object"
    }
  },
  "$id": "oscal.ssp.v1.SystemImplementation.schema.bundle.json",
  "$ref": "#/$defs/oscal.ssp.v1.SystemImplementation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
