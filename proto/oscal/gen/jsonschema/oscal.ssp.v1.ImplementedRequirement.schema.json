{
  "$id": "oscal.ssp.v1.ImplementedRequirement.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "ImplementedRequirement represents an implemented requirement",
  "patternProperties": {
    "^(byComponents)$": {
      "items": {
        "$ref": "oscal.ssp.v1.ByComponent.schema.json"
      },
      "type": "array"
    },
    "^(controlId)$": {
      "$ref": "oscal.common.v1.Token.schema.json"
    },
    "^(responsibleRoles)$": {
      "items": {
        "$ref": "oscal.ssp.v1.ResponsibleRole.schema.json"
      },
      "type": "array"
    },
    "^(setParameters)$": {
      "items": {
        "$ref": "oscal.ssp.v1.SetParameter.schema.json"
      },
      "type": "array"
    }
  },
  "properties": {
    "by_components": {
      "items": {
        "$ref": "oscal.ssp.v1.ByComponent.schema.json"
      },
      "type": "array"
    },
    "control_id": {
      "$ref": "oscal.common.v1.Token.schema.json"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
      },
      "type": "array"
    },
    "responsible_roles": {
      "items": {
        "$ref": "oscal.ssp.v1.ResponsibleRole.schema.json"
      },
      "type": "array"
    },
    "set_parameters": {
      "items": {
        "$ref": "oscal.ssp.v1.SetParameter.schema.json"
      },
      "type": "array"
    },
    "statements": {
      "items": {
        "$ref": "oscal.ssp.v1.Statement.schema.json"
      },
      "type": "array"
    },
    "uuid": {
      "$ref": "oscal.common.v1.UUID.schema.json"
    }
  },
  "title": "Implemented Requirement",
  "type": "object"
}
