{
  "$id": "oscal.mapping.v1.MappingItem.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "MappingItem represents a mapping entry item (source or target)",
  "patternProperties": {
    "^(idRef)$": {
      "default": "",
      "type": "string"
    }
  },
  "properties": {
    "id_ref": {
      "default": "",
      "type": "string"
    },
    "links": {
      "items": {
        "$ref": "oscal.common.v1.Link.schema.json"
      },
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "oscal.common.v1.Property.schema.json"
      },
      "type": "array"
    },
    "remarks": {
      "items": {
        "$ref": "oscal.common.v1.MarkupMultiline.schema.json"
      },
      "type": "array"
    },
    "type": {
      "default": "",
      "type": "string"
    }
  },
  "title": "Mapping Item",
  "type": "object"
}
