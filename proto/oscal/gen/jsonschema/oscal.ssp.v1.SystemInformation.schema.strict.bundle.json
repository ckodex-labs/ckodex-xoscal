{
  "$defs": {
    "oscal.common.v1.Link.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Link represents a hyperlink with metadata",
      "properties": {
        "href": {
          "$ref": "#/$defs/oscal.common.v1.URI.schema.strict.json"
        },
        "media_type": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "resource_fragment": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "rel",
        "media_type",
        "text",
        "resource_fragment"
      ],
      "title": "Link",
      "type": "object"
    },
    "oscal.common.v1.MarkupLine.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupLine represents a line of markup text (e.g., markdown)",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Line",
      "type": "object"
    },
    "oscal.common.v1.MarkupMultiline.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "MarkupMultiline represents multiline markup text",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Markup Multiline",
      "type": "object"
    },
    "oscal.common.v1.Property.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Property represents a key-value property with optional classification",
      "properties": {
        "class": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ns": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "class",
        "id",
        "ns"
      ],
      "title": "Property",
      "type": "object"
    },
    "oscal.common.v1.URI.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "URI represents a uniform resource identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "URI",
      "type": "object"
    },
    "oscal.common.v1.UUID.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "UUID represents a universally unique identifier",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "UUID",
      "type": "object"
    },
    "oscal.ssp.v1.Categorization.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Categorization represents an information type categorization",
      "properties": {
        "information_type_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "system": {
          "type": "string"
        }
      },
      "required": [
        "system"
      ],
      "title": "Categorization",
      "type": "object"
    },
    "oscal.ssp.v1.Impact.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Impact represents an impact level",
      "properties": {
        "adjustment_justification": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
        },
        "base": {
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "selected": {
          "type": "string"
        }
      },
      "required": [
        "base",
        "selected"
      ],
      "title": "Impact",
      "type": "object"
    },
    "oscal.ssp.v1.InformationType.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "InformationType represents an information type",
      "properties": {
        "availability_impact": {
          "$ref": "#/$defs/oscal.ssp.v1.Impact.schema.strict.json"
        },
        "categorizations": {
          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.Categorization.schema.strict.json"
          },
          "type": "array"
        },
        "confidentiality_impact": {
          "$ref": "#/$defs/oscal.ssp.v1.Impact.schema.strict.json"
        },
        "description": {
          "$ref": "#/$defs/oscal.common.v1.MarkupMultiline.schema.strict.json"
        },
        "integrity_impact": {
          "$ref": "#/$defs/oscal.ssp.v1.Impact.schema.strict.json"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/oscal.common.v1.MarkupLine.schema.strict.json"
        },
        "uuid": {
          "$ref": "#/$defs/oscal.common.v1.UUID.schema.strict.json"
        }
      },
      "title": "Information Type",
      "type": "object"
    },
    "oscal.ssp.v1.SystemInformation.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "SystemInformation represents system information",
      "properties": {
        "information_types": {
          "items": {
            "$ref": "#/$defs/oscal.ssp.v1.InformationType.schema.strict.json"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Link.schema.strict.json"
          },
          "type": "array"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/oscal.common.v1.Property.schema.strict.json"
          },
          "type": "array"
        }
      },
      "title": "System Information",
      "type": "object"
    }
  },
  "$id": "oscal.ssp.v1.SystemInformation.schema.strict.bundle.json",
  "$ref": "#/$defs/oscal.ssp.v1.SystemInformation.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
