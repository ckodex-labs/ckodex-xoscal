{
  "$defs": {
    "google.protobuf.Timestamp.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "oscal.services.v1.GraphEdge.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "claimId": {
          "type": "string"
        },
        "evidenceDigest": {
          "type": "string"
        },
        "extensionsJson": {
          "type": "string"
        },
        "fromNode": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "proofState": {
          "$ref": "#/$defs/oscal.services.v1.ProofState.jsonschema.strict.json"
        },
        "qualifier": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "toNode": {
          "type": "string"
        },
        "trustState": {
          "type": "string"
        },
        "validTime": {
          "$ref": "#/$defs/oscal.services.v1.TimeWindow.jsonschema.strict.json"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ],
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "id",
        "fromNode",
        "toNode",
        "relation",
        "qualifier",
        "claimId",
        "evidenceDigest",
        "trustState",
        "weight",
        "extensionsJson"
      ],
      "title": "Graph Edge",
      "type": "object"
    },
    "oscal.services.v1.GraphProjectionEvent.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "GraphProjectionEvent is an append-only, hash-chained audit record emitted\n in the same transaction as a successful edge projection.",
      "properties": {
        "claimId": {
          "type": "string"
        },
        "edgeId": {
          "type": "string"
        },
        "eventHash": {
          "type": "string"
        },
        "eventId": {
          "type": "string"
        },
        "evidenceDigest": {
          "type": "string"
        },
        "fromNode": {
          "type": "string"
        },
        "previousHash": {
          "type": "string"
        },
        "projectedAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.strict.json"
        },
        "relation": {
          "type": "string"
        },
        "sequence": {
          "type": "integer"
        },
        "toNode": {
          "type": "string"
        },
        "trustState": {
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "eventId",
        "edgeId",
        "claimId",
        "fromNode",
        "toNode",
        "relation",
        "evidenceDigest",
        "trustState",
        "previousHash",
        "eventHash"
      ],
      "title": "Graph Projection Event",
      "type": "object"
    },
    "oscal.services.v1.ProjectEdgeResponse.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "edge": {
          "$ref": "#/$defs/oscal.services.v1.GraphEdge.jsonschema.strict.json"
        },
        "projectionEvent": {
          "$ref": "#/$defs/oscal.services.v1.GraphProjectionEvent.jsonschema.strict.json"
        }
      },
      "title": "Project Edge Response",
      "type": "object"
    },
    "oscal.services.v1.ProofState.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string"
        },
        "discovery": {
          "type": "string"
        },
        "graph": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "transparency": {
          "type": "string"
        },
        "witnessJson": {
          "type": "string"
        }
      },
      "required": [
        "discovery",
        "graph",
        "claim",
        "source",
        "signature",
        "transparency",
        "witnessJson",
        "state",
        "policy"
      ],
      "title": "Proof State",
      "type": "object"
    },
    "oscal.services.v1.TimeWindow.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "fromTime": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.strict.json"
        },
        "toTime": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.strict.json"
        }
      },
      "title": "Time Window",
      "type": "object"
    }
  },
  "$id": "oscal.services.v1.ProjectEdgeResponse.jsonschema.strict.bundle.json",
  "$ref": "#/$defs/oscal.services.v1.ProjectEdgeResponse.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
