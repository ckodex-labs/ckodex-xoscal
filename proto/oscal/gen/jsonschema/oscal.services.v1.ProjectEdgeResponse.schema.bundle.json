{
  "$defs": {
    "google.protobuf.Timestamp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "oscal.services.v1.GraphEdge.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(claimId)$": {
          "default": "",
          "type": "string"
        },
        "^(evidenceDigest)$": {
          "default": "",
          "type": "string"
        },
        "^(extensionsJson)$": {
          "default": "",
          "type": "string"
        },
        "^(fromNode)$": {
          "default": "",
          "type": "string"
        },
        "^(proofState)$": {
          "$ref": "#/$defs/oscal.services.v1.ProofState.schema.json"
        },
        "^(toNode)$": {
          "default": "",
          "type": "string"
        },
        "^(trustState)$": {
          "default": "",
          "type": "string"
        },
        "^(validTime)$": {
          "$ref": "#/$defs/oscal.services.v1.TimeWindow.schema.json"
        }
      },
      "properties": {
        "claim_id": {
          "default": "",
          "type": "string"
        },
        "evidence_digest": {
          "default": "",
          "type": "string"
        },
        "extensions_json": {
          "default": "",
          "type": "string"
        },
        "from_node": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "proof_state": {
          "$ref": "#/$defs/oscal.services.v1.ProofState.schema.json"
        },
        "qualifier": {
          "default": "",
          "type": "string"
        },
        "relation": {
          "default": "",
          "type": "string"
        },
        "to_node": {
          "default": "",
          "type": "string"
        },
        "trust_state": {
          "default": "",
          "type": "string"
        },
        "valid_time": {
          "$ref": "#/$defs/oscal.services.v1.TimeWindow.schema.json"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ],
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "title": "Graph Edge",
      "type": "object"
    },
    "oscal.services.v1.GraphProjectionEvent.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "GraphProjectionEvent is an append-only, hash-chained audit record emitted\n in the same transaction as a successful edge projection.",
      "patternProperties": {
        "^(claimId)$": {
          "default": "",
          "type": "string"
        },
        "^(edgeId)$": {
          "default": "",
          "type": "string"
        },
        "^(eventHash)$": {
          "default": "",
          "type": "string"
        },
        "^(eventId)$": {
          "default": "",
          "type": "string"
        },
        "^(evidenceDigest)$": {
          "default": "",
          "type": "string"
        },
        "^(fromNode)$": {
          "default": "",
          "type": "string"
        },
        "^(previousHash)$": {
          "default": "",
          "type": "string"
        },
        "^(projectedAt)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "^(toNode)$": {
          "default": "",
          "type": "string"
        },
        "^(trustState)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "claim_id": {
          "default": "",
          "type": "string"
        },
        "edge_id": {
          "default": "",
          "type": "string"
        },
        "event_hash": {
          "default": "",
          "type": "string"
        },
        "event_id": {
          "default": "",
          "type": "string"
        },
        "evidence_digest": {
          "default": "",
          "type": "string"
        },
        "from_node": {
          "default": "",
          "type": "string"
        },
        "previous_hash": {
          "default": "",
          "type": "string"
        },
        "projected_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "relation": {
          "default": "",
          "type": "string"
        },
        "sequence": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "to_node": {
          "default": "",
          "type": "string"
        },
        "trust_state": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Graph Projection Event",
      "type": "object"
    },
    "oscal.services.v1.ProjectEdgeResponse.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(projectionEvent)$": {
          "$ref": "#/$defs/oscal.services.v1.GraphProjectionEvent.schema.json"
        }
      },
      "properties": {
        "edge": {
          "$ref": "#/$defs/oscal.services.v1.GraphEdge.schema.json"
        },
        "projection_event": {
          "$ref": "#/$defs/oscal.services.v1.GraphProjectionEvent.schema.json"
        }
      },
      "title": "Project Edge Response",
      "type": "object"
    },
    "oscal.services.v1.ProofState.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(witnessJson)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "claim": {
          "default": "",
          "type": "string"
        },
        "discovery": {
          "default": "",
          "type": "string"
        },
        "graph": {
          "default": "",
          "type": "string"
        },
        "policy": {
          "default": "",
          "type": "string"
        },
        "signature": {
          "default": "",
          "type": "string"
        },
        "source": {
          "default": "",
          "type": "string"
        },
        "state": {
          "default": "",
          "type": "string"
        },
        "transparency": {
          "default": "",
          "type": "string"
        },
        "witness_json": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Proof State",
      "type": "object"
    },
    "oscal.services.v1.TimeWindow.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(fromTime)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "^(toTime)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        }
      },
      "properties": {
        "from_time": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "to_time": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        }
      },
      "title": "Time Window",
      "type": "object"
    }
  },
  "$id": "oscal.services.v1.ProjectEdgeResponse.schema.bundle.json",
  "$ref": "#/$defs/oscal.services.v1.ProjectEdgeResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
