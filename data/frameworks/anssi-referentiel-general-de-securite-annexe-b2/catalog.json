                  {
                    "id": "_2.6.1.1-stmt",
                    "name": "statement",
                    "prose": "Il est recommandé que la diffusion d’une clé privée ou secrète soit limitée aux seuls environnements de confiance qui l’utilisent vraiment."
                  }
                ],
                "props": [
                  {
                    "name": "implementation-groups",
                    "ns": "https://ckodex.io/ns/xoscal/props",
                    "value": "[Recommandation]"
                  }
                ],
                "title": "RecomDiffusion-1"
